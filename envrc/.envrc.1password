# .envrc - Global Environment Variables
# Uses 1Password CLI to securely load secrets
# This file is loaded by direnv for the home directory

export OP_VAULT_ID="y5l42cppvgu22o2obesu4ctla4"
export OP_VAULT="develop"
export OP_ITEM="apikeys"

# Load secrets from 1Password
# Source functions to get op_load_item
if [[ -f "$HOME/dotfiles/zsh/functions.zsh" ]]; then
    source "$HOME/dotfiles/zsh/functions.zsh"
    
    # Load secrets silently (no messages if it fails)
    # op_load_item signature: "vault" "item" [vault_id] [account_email] [verbose]
    op_load_item "$OP_VAULT" "$OP_ITEM" "$OP_VAULT_ID" "" "false" 2>/dev/null || true
else
    echo "Error: functions.zsh not found at $HOME/dotfiles/zsh/functions.zsh" >&2
fi
