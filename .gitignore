.DS_Store
# Third-party clones (any path named upstream/). Exception: Cursor Classic Store archive.
upstream/
!cursor/raycast/cursor-classic-extension/upstream/
!cursor/raycast/cursor-classic-extension/upstream/**
.vscode/extensions/*
.op_session
.envrc
*.backup.*
# Cursor workspace dumps: ignore only legacy flat files under cursor/ (tracked triplet dumps live in snapshots/workspace/)
/cursor/cursor-workspace-*
antigravity-archive/
disabled/
forks/

# Timestamped copies from scripts/snapshot-zshrc (see zsh/snapshots/README.md)
zsh/snapshots/.zshrc.*
