# Wave 0: the shell is usable and Cursor opens. Foreground, ~2 minutes.
# brew bundle installs in file order: small bottles, then the Cursor cask
# (prefetched at t=0 by script/setup), then mise so wave 3 can run later.
# Do NOT add anything here that is not needed to open an editor with a good shell.

brew "git"
brew "gh"
brew "just"
brew "chezmoi"
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "fzf"
brew "zoxide"
brew "eza"
brew "bat"
brew "fd"
brew "ripgrep"
brew "jq"
brew "tree"

cask "cursor"

brew "mise"
