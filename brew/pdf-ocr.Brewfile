# Opt-in layer, named by job: turn scanned PDFs into text.
#   just bundle pdf-ocr
# Heavy (tesseract + leptonica + ghostscript, ~+25 packages). ERN extract-text
# depends on it; nobody else needs it day one. ocrmypdf itself is a uv tool:
#   uv tool install ocrmypdf
# Do NOT put this in data-common.

brew "tesseract"
brew "tesseract-lang"
brew "ghostscript"
brew "unpaper"
brew "pngquant"
brew "jbig2enc"
