#!/usr/bin/env bash
# script/setup: the ONE installer. Runs the common layer in waves so the shell
# is usable at t=0 and Cursor opens at ~t=2min while the rest installs behind.
#
#   script/setup            # foreground wave 0, then background waves 1-5
#   script/setup --force    # ignore a chezmoi sourceDir that points elsewhere
#   script/setup --waves    # (internal) the background chain
#   just status [--wait]    # progress / block until the chain finishes
#
# Consumer logins (standard user, no sudo; e.g. `demo`) get dotfiles and wave 3
# only: everything that writes under $HOME. Every brew bundle is skipped with
# one log line; the bottles the owner installed are already on PATH.
#
# Rules: adopt the existing /opt/homebrew (never install brew here); one brew
# process at a time; each wave is its own Brewfile so a failure isolates;
# delegates run every brew as the owner via sudo -Hu with the Brewfile on stdin.
# Strap: this is the script Strap calls after brew exists. There is no
# ~/.Brewfile, so Strap's `brew bundle --global` step is a no-op by design.
set -euo pipefail

repo="$(cd "$(dirname "$0")/.." && pwd)"
# shellcheck source=lib.sh
. "$repo/script/lib.sh"
export BOOTSTRAP_SETUP=1
export HOMEBREW_NO_ENV_HINTS=1

# --- background chain (waves 1-5) -------------------------------------------
run_waves() {
  export BOOTSTRAP_CHAIN=1
  echo $$ >"$BOOTSTRAP_PID"
  trap 'rm -f "$BOOTSTRAP_PID"; bootstrap_sudo_keepalive_stop' EXIT
  export HOMEBREW_NO_AUTO_UPDATE=1
  local mode; mode="$(bootstrap_brew_mode)"

  if [[ "$mode" == consumer ]]; then
    bootstrap_log "consumer login: waves 1, 2, 4, 5 (brew) skipped; wave 3 only"
    bootstrap_log "== wave 3 start (mise install, uv tools)"
    if bootstrap_mise install -y 2>&1 | _bootstrap_out; then
      BOOTSTRAP_SETUP= bash "$repo/home/.chezmoiscripts/run_onchange_after_30-uv-tools.sh" 2>&1 | _bootstrap_out || true
    else
      bootstrap_log "!! mise install failed; uv tools skipped"
    fi
    bootstrap_log "== wave 3 done"
    if [[ -x /opt/homebrew/bin/whatbroke ]]; then
      /opt/homebrew/bin/whatbroke install 2>&1 | _bootstrap_out || true
      bootstrap_log "whatbroke daily snapshot installed for $(id -un)"
    fi
    if [[ -x "$repo/script/org-setup" ]]; then
      bootstrap_log "script/org-setup"
      "$repo/script/org-setup" 2>&1 | _bootstrap_out || bootstrap_log "!! org-setup had failures"
    fi
    bootstrap_log "== chain complete (consumer). Installed tools come from the brew owner; ask them for anything missing."
    return 0
  fi

  bootstrap_sudo_keepalive

  local waves=(
    "1|$repo/brew/10-common.Brewfile"
    "2|$repo/brew/20-data-common.Brewfile"
  )
  # wave 4 = every brew/3*.Brewfile; wave 5 = every brew/4*.Brewfile (org overlay)
  local f w4=() w5=()
  for f in "$repo"/brew/3*.Brewfile; do [[ -f "$f" ]] && w4+=("$f"); done
  for f in "$repo"/brew/4*.Brewfile; do [[ -f "$f" ]] && w5+=("$f"); done

  # waves 1 and 2: install N now; prefetch N+1 meanwhile (brew's per-file
  # download locks make the two processes cooperate, never duplicate).
  local fetch_pid=""
  local entry n file next
  for entry in "${waves[@]}"; do
    n="${entry%%|*}"; file="${entry#*|}"
    [[ -n "$fetch_pid" ]] && { wait "$fetch_pid" 2>/dev/null || true; }
    case "$n" in
      1) next="$repo/brew/20-data-common.Brewfile" ;;
      2) next="${w4[0]:-}" ;;
    esac
    if [[ -n "$next" ]]; then bootstrap_brew_fetch_file "$next" & fetch_pid=$!; else fetch_pid=""; fi
    bootstrap_log "== wave $n start"
    bootstrap_brew_bundle "$file" || bootstrap_log "!! wave $n had failures (see above); continuing"
    bootstrap_log "== wave $n done"
  done

  # wave 3: runtimes via mise, then uv tools
  bootstrap_log "== wave 3 start (mise install, uv tools)"
  if bootstrap_mise install -y 2>&1 | _bootstrap_out; then
    BOOTSTRAP_SETUP= bash "$repo/home/.chezmoiscripts/run_onchange_after_30-uv-tools.sh" 2>&1 | _bootstrap_out || true
  else
    bootstrap_log "!! mise install failed; uv tools skipped"
  fi
  bootstrap_log "== wave 3 done"

  # wave 4: vendor casks, local dev, drift
  [[ -n "$fetch_pid" ]] && { wait "$fetch_pid" 2>/dev/null || true; }
  bootstrap_log "== wave 4 start"
  local i
  for (( i=0; i<${#w4[@]}; i++ )); do
    if (( i+1 < ${#w4[@]} )); then bootstrap_brew_fetch_file "${w4[$((i+1))]}" & fetch_pid=$!; else fetch_pid=""; fi
    bootstrap_brew_bundle "${w4[$i]}" || bootstrap_log "!! $(basename "${w4[$i]}") had failures; continuing"
    [[ -n "$fetch_pid" ]] && { wait "$fetch_pid" 2>/dev/null || true; }
  done
  if command -v whatbroke >/dev/null 2>&1 || [[ -x /opt/homebrew/bin/whatbroke ]]; then
    "${HOMEBREW_PREFIX:-/opt/homebrew}/bin/whatbroke" install 2>&1 | _bootstrap_out || true
    bootstrap_log "whatbroke daily snapshot installed for $(id -un)"
  fi
  bootstrap_log "== wave 4 done"

  # wave 5: org overlay (brew/4*.Brewfile, script/org-setup), or personal overlay for me
  bootstrap_log "== wave 5 start"
  for f in ${w5[@]+"${w5[@]}"}; do
    bootstrap_brew_bundle "$f" || bootstrap_log "!! $(basename "$f") had failures; continuing"
  done
  if [[ -x "$repo/script/org-setup" ]]; then
    bootstrap_log "script/org-setup"
    "$repo/script/org-setup" 2>&1 | _bootstrap_out || bootstrap_log "!! org-setup had failures"
  fi
  if [[ -d "$HOME/src/dotfiles-private" && -f "$repo/justfile" ]] && grep -q '^apply-private' "$repo/justfile"; then
    bootstrap_log "just apply-private"
    (cd "$repo" && just apply-private) 2>&1 | _bootstrap_out || bootstrap_log "!! apply-private had failures"
  fi
  bootstrap_log "== wave 5 done"
  bootstrap_log "== chain complete. Summary:"
  for f in "$repo"/brew/[0-4]*.Brewfile; do
    if bootstrap_brew_bundle_check "$f"; then bootstrap_log "   ok   $(basename "$f")"; else bootstrap_log "   unmet $(basename "$f")  -> just bundle $(basename "$f" .Brewfile)"; fi
  done
}

if [[ "${1:-}" == --waves ]]; then
  run_waves
  exit 0
fi

# --- foreground: guards, dotfiles, wave 0 ------------------------------------
[[ "$(uname -s)" == Darwin ]] || bootstrap_die "macOS only"
prefix="$(bootstrap_brew_prefix)" || bootstrap_die "no /opt/homebrew. Install Homebrew as the person who should own it (brew.sh, or Strap on a new Mac). Never as a team login."
owner="$(bootstrap_brew_owner)"
me="$(id -un)"
mode="$(bootstrap_brew_mode)"
mkdir -p "$BOOTSTRAP_LOG_DIR"
case "$mode" in
  owner)    bootstrap_log "script/setup as $me; brew prefix $prefix owned by $me" ;;
  delegate) bootstrap_log "script/setup as $me; brew prefix $prefix owned by $owner (delegate: brew writes via sudo -Hu $owner)" ;;
  consumer) bootstrap_log "script/setup as $me; brew prefix $prefix owned by $owner (consumer: no sudo, no installs; dotfiles + wave 3 only)" ;;
esac
if bootstrap_chain_running; then
  bootstrap_die "a background chain is already running (pid $(cat "$BOOTSTRAP_PID")); just status --wait"
fi

# One chezmoi source per login. A second clone (Strap's ~/.dotfiles, a stray
# checkout) must not silently take over; symlink it to this repo instead.
cfg="$HOME/.config/chezmoi/chezmoi.toml"
if [[ -f "$cfg" && "${1:-}" != --force ]]; then
  pinned="$(sed -n 's/^sourceDir *= *"\(.*\)"/\1/p' "$cfg" | head -1)"
  pinned_real="$(cd "$pinned" 2>/dev/null && pwd -P || echo "$pinned")"
  repo_real="$(cd "$repo" && pwd -P)"
  if [[ -n "$pinned" && "$pinned_real" != "$repo_real" ]]; then
    bootstrap_die "chezmoi already uses $pinned, not $repo.
  Either run script/setup from there, or make this the one source:
    ln -sfn $repo $pinned      # if $pinned is a stray clone (check for local commits first)
    script/setup --force       # to re-point chezmoi at $repo"
  fi
fi

# t=0: Cursor download starts now (cask is ~250 MB); bundle later finds it cached.
cursor_fetch=""
if [[ "$mode" != consumer ]]; then
  bootstrap_sudo_keepalive
  bootstrap_log "brew update (once)"
  bootstrap_brew update --quiet 2>&1 | tail -1 | tee -a "$BOOTSTRAP_LOG" || true
  export HOMEBREW_NO_AUTO_UPDATE=1
  if [[ ! -d /Applications/Cursor.app ]]; then
    bootstrap_brew fetch --cask cursor >/dev/null 2>&1 &
    cursor_fetch=$!
  fi
fi

# dotfiles: seconds. Hooks no-op under BOOTSTRAP_SETUP=1 except the fast defaults script.
if ! command -v chezmoi >/dev/null 2>&1 && [[ ! -x "$HOME/.local/bin/chezmoi" ]]; then
  bootstrap_log "chezmoi via get.chezmoi.io -> ~/.local/bin (no brew needed)"
  sh -c "$(curl -fsLS get.chezmoi.io)" -- -b "$HOME/.local/bin" >/dev/null
fi
CHEZMOI="$(command -v chezmoi || echo "$HOME/.local/bin/chezmoi")"
bootstrap_log "chezmoi init --apply --source $repo"
"$CHEZMOI" init --apply --source "$repo" --force

# wave 0, foreground
if [[ "$mode" == consumer ]]; then
  bootstrap_log "== wave 0 skipped (consumer): shell tools come from $owner's brew"
else
  bootstrap_log "== wave 0 start (shell tools, Cursor, mise)"
  bootstrap_brew_bundle "$repo/brew/00-shell.Brewfile" || bootstrap_log "!! wave 0 had failures; the shell may be partial"
  [[ -n "$cursor_fetch" ]] && { wait "$cursor_fetch" 2>/dev/null || true; }
  bootstrap_log "== wave 0 done"
  bootstrap_sudo_keepalive_stop
fi

# hand off waves 1-5 in their own session so closing this terminal (or a
# parent that kills its process group) cannot take the chain down with it.
if command -v perl >/dev/null 2>&1; then
  perl -e 'use POSIX; POSIX::setsid(); exec @ARGV' -- bash "$repo/script/setup" --waves >>"$BOOTSTRAP_LOG" 2>&1 &
elif command -v python3 >/dev/null 2>&1; then
  python3 -c 'import os,sys; os.setsid(); os.execvp(sys.argv[1], sys.argv[1:])' bash "$repo/script/setup" --waves >>"$BOOTSTRAP_LOG" 2>&1 &
else
  nohup bash "$repo/script/setup" --waves >>"$BOOTSTRAP_LOG" 2>&1 &
fi
disown 2>/dev/null || true
sleep 2
bootstrap_chain_running || bootstrap_log "!! background chain did not start; run: bash $repo/script/setup --waves"

cat <<EOF

  Shell is ready: open a new terminal tab (or: exec zsh).
  Cursor is installed: opening it now. Keep working; waves 1-5 continue behind.

    just status          # progress
    just status --wait   # block until everything is in
    tail -f $BOOTSTRAP_LOG

  A manual 'brew install' during the chain just waits on Homebrew's lock.
EOF
if [[ -d /Applications/Cursor.app ]]; then
  open -a Cursor "$repo" 2>/dev/null || open -a Cursor 2>/dev/null || true
fi
