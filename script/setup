#!/usr/bin/env bash
# Strap hook: https://github.com/MikeMcQuaid/strap
set -euo pipefail
cd "$(dirname "$0")/.."
if ! command -v chezmoi >/dev/null 2>&1; then
  if command -v brew >/dev/null 2>&1; then
    brew install chezmoi
  else
    echo "install Homebrew, then: brew install chezmoi" >&2
    exit 1
  fi
fi
chezmoi init --apply --source "$PWD"
