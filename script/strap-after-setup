#!/usr/bin/env bash
# Strap calls this last. script/setup already started the background chain;
# block here until it finishes so Strap ends with a complete system and never
# starts a second installer.
set -euo pipefail
cd "$(dirname "$0")/.."
if command -v just >/dev/null 2>&1; then
  just status --wait
else
  /opt/homebrew/bin/just status --wait
fi
