//// From Vim Extension setting: https://marketplace.cursorapi.com/items/?itemName=vscodevim.vim

// defaults write com.microsoft.VSCode ApplePressAndHoldEnabled -bool false              # For VS Code
// defaults write com.microsoft.VSCodeInsiders ApplePressAndHoldEnabled -bool false      # For VS Code Insider
// defaults write com.vscodium ApplePressAndHoldEnabled -bool false                      # For VS Codium
// defaults write com.microsoft.VSCodeExploration ApplePressAndHoldEnabled -bool false   # For VS Codium Exploration users
// defaults write com.exafunction.windsurf ApplePressAndHoldEnabled -bool false          # For Windsurf
// defaults write com.todesktop.230313mzl4w4u92 ApplePressAndHoldEnabled -bool false     # For Cursor
// defaults delete -g ApplePressAndHoldEnabled                                           # If necessary, reset global default
// defaults write -g ApplePressAndHoldEnabled -bool false                                # Set global default to false

// Explanation:
// - ApplePressAndHoldEnabled controls whether holding a key shows the accent/character picker (true)
//   or produces a continuous key repeat (false).
// - VSCodeVim relies on fast, continuous key repeat for motions (e.g., holding h/j/k/l to move),
//   so each editor's bundle ID is configured with ApplePressAndHoldEnabled = false.
// - The final command removes any global override so the system-wide behavior can remain at
//   its macOS default, while these editor-specific settings ensure proper Vim-style key repeat.
