[
  // === KEYBINDING TROUBLESHOOTING (Cursor / VS Code) ===
  // See docs/keybindings-guide.md for full observability and modification guide.
  //
  // Quick observability:
  //   • Cmd+Shift+P → "Developer: Toggle Keyboard Shortcuts Troubleshooting"
  //     → Enables live logging: press a key and check Output panel to see which
  //       command matched, its "when" clause, and source (built-in / User / extension).
  //   • Cmd+Shift+P → "Preferences: Open Keyboard Shortcuts" (or Cmd+K Cmd+S)
  //     → Search by key (e.g. "tab") to list all bindings; right-click a row →
  //       "Show Same Keybindings" to see what shadows that key.
  //   • Cmd+Shift+P → "Developer: Inspect Context Keys"
  //     → Click a UI element to see current context (e.g. editorLangId, terminalFocus)
  //       so you can write accurate "when" clauses.
  //   • Cmd+Shift+P → "Preferences: Open Default Keyboard Shortcuts (JSON)"
  //     → View all default + extension keybindings and their when clauses.
  //
  // Resolution order: rules evaluated bottom-to-top; first matching key + when wins.
  // User keybindings (this file) are merged and can override. Use "-commandId" to
  // remove a binding (optionally with "when" to remove only in that context).
  // ===

  // testing

  {
  "key": "shift+alt+x",
  "command": "whichkey.show",
  // "when": "editorTextFocus"
},
  // https://vspacecode.github.io/docs/bonus/
  // Quick Window Navigation: To navigate all the windows including slide and bottom pane with Ctrl-h/j/k/l, you can merge the following config system's key bindings to your keybindings.json file.
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "!terminalFocus && !inQuickOpen && !suggestWidgetVisible && !parameterHintsVisible && !isInDiffEditor",
  },
  {
    "key": "ctrl+j",
    "command": "workbench.action.navigateDown",
    "when": "!terminalFocus && !codeActionMenuVisible && !inQuickOpen && !suggestWidgetVisible && !parameterHintsVisible",
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.navigateUp",
    "when": "!terminalFocus && !codeActionMenuVisible && !inQuickOpen && !suggestWidgetVisible && !parameterHintsVisible",
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "!terminalFocus && !codeActionMenuVisible && !inQuickOpen && !suggestWidgetVisible && !parameterHintsVisible && !isInDiffEditor",
  },

  // Quick Navigation for diff view
  {
    "key": "ctrl+h",
    "command": "workbench.action.compareEditor.focusSecondarySide",
    "when": "isInDiffEditor && !isInDiffLeftEditor",
  },
  {
    "key": "ctrl+h",
    "command": "workbench.action.navigateLeft",
    "when": "isInDiffEditor && isInDiffLeftEditor",
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.compareEditor.focusPrimarySide",
    "when": "isInDiffEditor && isInDiffLeftEditor",
  },
  {
    "key": "ctrl+l",
    "command": "workbench.action.navigateRight",
    "when": "isInDiffEditor && !isInDiffLeftEditor",
  },

  // Trigger vspacecode in empty editor group
  {
    "key": "space",
    "command": "vspacecode.space",
    "when": "activeEditorGroupEmpty && focusedView == '' && !whichkeyActive && !inputFocus",
  },
  // Trigger vspacecode when sidebar is in focus
  {
    "key": "space",
    "command": "vspacecode.space",
    "when": "sideBarFocus && !inputFocus && !whichkeyActive",
  },

  // Keybindings required for edamagit
  // https://github.com/kahole/edamagit#vim-support-vscodevim
  // Cannot be added to package.json because keybinding replacements
  // Ctrl+J / Ctrl+K: jump between sections in magit (next/previous entity)
  {
    "key": "ctrl+j",
    "command": "magit.move-next-entity",
    "when": "editorTextFocus && (editorLangId == 'magit' || editorLangId =~ /magit/)"
  },
  {
    "key": "ctrl+k",
    "command": "magit.move-previous-entity",
    "when": "editorTextFocus && (editorLangId == 'magit' || editorLangId =~ /magit/)"
  },
  // Strip Vim Tab everywhere, then re-add only when NOT in a magit buffer (so Magit Toggle Fold gets Tab there)
  {
    "key": "tab",
    "command": "-extension.vim_tab"
  },
  {
    "key": "tab",
    "command": "extension.vim_tab",
    "when": "editorTextFocus && vim.active && !inDebugRepl && !inlineEditIsVisible && vim.mode != 'Insert' && !(editorLangId =~ /magit/)"
  },
  {
    "key": "x",
    "command": "magit.discard-at-point",
    "when": "editorTextFocus && editorLangId == 'magit' && vim.mode =~ /^(?!SearchInProgressMode|CommandlineInProgress).*$/",
  },
  {
    "key": "k",
    "command": "-magit.discard-at-point",
  },
  {
    "key": "-",
    "command": "magit.reverse-at-point",
    "when": "editorTextFocus && editorLangId == 'magit' && vim.mode =~ /^(?!SearchInProgressMode|CommandlineInProgress).*$/",
  },
  {
    "key": "v",
    "command": "-magit.reverse-at-point",
  },
  {
    "key": "shift+-",
    "command": "magit.reverting",
    "when": "editorTextFocus && editorLangId == 'magit' && vim.mode =~ /^(?!SearchInProgressMode|CommandlineInProgress).*$/",
  },
  {
    "key": "shift+v",
    "command": "-magit.reverting",
  },
  {
    "key": "shift+o",
    "command": "magit.resetting",
    "when": "editorTextFocus && editorLangId == 'magit' && vim.mode =~ /^(?!SearchInProgressMode|CommandlineInProgress).*$/",
  },
  {
    "key": "shift+x",
    "command": "-magit.resetting",
  },
  {
    "key": "x",
    "command": "-magit.reset-mixed",
  },
  {
    "key": "ctrl+u x",
    "command": "-magit.reset-hard",
  },
  // Extra ref menu support for edamagit with the key "y"
  // Cannot be added to package.json because keybinding replacements
  {
    "key": "y",
    "command": "-magit.show-refs",
  },
  {
    "key": "y",
    "command": "vspacecode.showMagitRefMenu",
    "when": "editorTextFocus && editorLangId == 'magit' && vim.mode == 'Normal'",
  },
  // Extra refresh menu support for edamagit with the key "g"
  // Cannot be added to package.json because keybinding replacements
  {
    "key": "g",
    "command": "-magit.refresh",
    "when": "editorTextFocus && editorLangId == 'magit' && vim.mode =~ /^(?!SearchInProgressMode|CommandlineInProgress).*$/",
  },
  {
    "key": "g",
    "command": "vspacecode.showMagitRefreshMenu",
    "when": "editorTextFocus && editorLangId == 'magit' && vim.mode =~ /^(?!SearchInProgressMode|CommandlineInProgress).*$/",
  },

  
  // Easy navigation in quick open/QuickPick
  {
    "key": "ctrl+j",
    "command": "workbench.action.quickOpenSelectNext",
    "when": "inQuickOpen",
  },
  {
    "key": "ctrl+k",
    "command": "workbench.action.quickOpenSelectPrevious",
    "when": "inQuickOpen",
  },
  // Easy navigation in suggestion/intellisense
  // Cannot be added to package.json because of conflict with vim's default bindings
  {
    "key": "ctrl+j",
    "command": "selectNextSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus",
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus",
  },
  {
    "key": "ctrl+l",
    "command": "acceptSelectedSuggestion",
    "when": "suggestWidgetMultipleSuggestions && suggestWidgetVisible && textInputFocus",
  },
  // Easy navigation in parameter hint (i.e. traverse the hints when there's multiple overload for one method)
  // Cannot be added to package.json because of conflict with vim's default bindings
  {
    "key": "ctrl+j",
    "command": "showNextParameterHint",
    "when": "editorFocus && parameterHintsMultipleSignatures && parameterHintsVisible",
  },
  {
    "key": "ctrl+k",
    "command": "showPrevParameterHint",
    "when": "editorFocus && parameterHintsMultipleSignatures && parameterHintsVisible",
  },
  // Easy navigation in code action
  {
    "key": "ctrl+j",
    "command": "selectNextCodeAction",
    "when": "codeActionMenuVisible",
  },
  {
    "key": "ctrl+k",
    "command": "selectPrevCodeAction",
    "when": "codeActionMenuVisible",
  },
  {
    "key": "ctrl+l",
    "command": "acceptSelectedCodeAction",
    "when": "codeActionMenuVisible",
  },
  // Add ctrl+h/l to navigate in file browser
  {
    "key": "ctrl+h",
    "command": "file-browser.stepOut",
    "when": "inFileBrowser",
  },
  // {
  //     "key": "ctrl+l",
  //     "command": "file-browser.stepIn",
  //     "when": "inFileBrowser"
  // },
  {
    "key": "ctrl+l",
    "when": "terminalFocus",
    "command": "-workbench.action.showActivityBar",
  },

  // https://docs.cursor.com/features/generate-commit-message
  {
    "key": "cmd+m",
    "command": "cursor.generateGitCommitMessage",
    // "when": "scm.inputBoxFocus"
  },
  // https://docs.cursor.com/features/generate-commit-message
  {
    "key": "ctrl+shift+m",
    "command": "cursor.generateGitCommitMessage",
    "when": "workbench.scm.active",
  },
  {
    "key": "ctrl+x d",
    "command": "extension.dired.open",
    "when": "editorTextFocus && !inDebugRepl",
  },
  {
    "key": "ctrl+x d",
    "command": "extension.dired.open",
    "when": "inputFocus && editorLangId == 'chat'",
  },
  // Enable Alt+. to jump to definition in terminal
  // This sends the escape sequence \u001b (ESC) followed by .
  // which is the standard key sequence for "go to definition" in many shells
  {
    "key": "alt+.",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001b.", // ESC + . sequence
    },
    "when": "terminalFocus",
  },
  {
    "key": "alt+b",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001bb", // ESC + . sequence
    },
    "when": "terminalFocus",
  },
  {
    "key": "alt+f",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u001bf", // ESC + . sequence
    },
    "when": "terminalFocus",
  },
  {
    "key": "ctrl+x ctrl+f",
    "command": "workbench.action.quickOpen",
  },
  {
    "key": "ctrl+x ctrl+f",
    "command": "workbench.action.quickOpen",
    "when": "composerFocused || focusedView =~ /^workbench.panel.aichat.view/",
  },
  {
    "key": "ctrl+x ctrl+f",
    "command": "workbench.action.quickOpen",
    "when": "inputFocus && editorLangId == 'plaintext'",
  },
  {
    "key": "ctrl+x ctrl+f",
    "command": "workbench.action.quickOpen",
    "when": "focusedView == 'workbench.panel.aichat.view'",
  },
  // https://marketplace.visualstudio.com/items?itemName=YuTengjing.vscode-classic-experience
  // https://github.com/tjx666/vscode-classic-experience
  {
    // FIXME: this is not working no matter what I try
    "key": "ctrl+x ctrl+f",
    "command": "workbench.action.quickOpen",
    "when": "!editorFocus && !terminalFocus",
    // "when": "composerBarIsVisible"
    // "when": "aichat.view.focused"
    // "when": "view.workbench.panel.aichat.view.visible && focusedView == 'workbench.panel.aichat.view'"
    // "when": "view.workbench.panel.aichat.view.visible"
  },
  {
    "key": "ctrl+x ctrl+f",
    "command": "workbench.action.quickOpen",
    "when": "inputFocus && editorLangId == 'chat'",
  },
  {
    "key": "ctrl+x ctrl+f",
    "command": "-workbench.action.quickOpen",
    "when": "!terminalFocus",
  },
  {
    "key": "ctrl+shift+m",
    "command": "-editor.action.toggleTabFocusMode",
  },
  {
    "key": "shift+cmd+c",
    "command": "workbench.action.terminal.copyLastCommandAndLastCommandOutput",
    "when": "terminalFocus",
  },

  // https://marketplace.visualstudio.com/items?itemName=ms-vscode.vscode-speech
  {
    "key": "alt+shift+u",
    "command": "workbench.action.chat.startVoiceChat",
    "when": "!voiceChatInProgress",
  },
  {
    "key": "alt+shift+u",
    "command": "workbench.action.chat.stopListeningAndSubmit",
    "when": "voiceChatInProgress",
  },
  {
    "key": "alt+shift+d",
    "command": "workbench.action.editorDictation.start",
    "when": "!editorDictation.inProgress",
  },
  {
    "key": "alt+shift+d",
    "command": "workbench.action.editorDictation.stop",
    "when": "editorDictation.inProgress",
  },
  {
    "key": "shift+alt+c",
    "command": "workbench.action.terminal.copyLastCommand",
  },
  {
    "key": "cmd+r cmd+p",
    "command": "workbench.action.toggleMaximizedPanel",
  },
  {
    "key": "cmd+r cmd+h",
    "command": "workbench.action.maximizeEditorHideSidebar",
  },
  {
    "key": "cmd+;",
    "command": "editor.action.insertSnippet",
    "args": {
      "snippet": "${CURRENT_YEAR}-${CURRENT_MONTH}-${CURRENT_DATE}",
    },
    "when": "editorTextFocus",
  },
  {
    "key": "cmd+i",
    "command": "composerMode.agent",
  },
  {
    "key": "cmd+i",
    "command": "composerMode.agent",
  },
  {
    "key": "shift+cmd+space",
    "command": "vspacecode-expanded.space",
    "when": "!editorTextFocus",
  },
  {
    // pass through Ctrl+X to terminal session
    "key": "ctrl+x ctrl+x",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\u0018\u0018", // send ctrl+x passthru
    },
    "when": "terminalFocus",
  },
  {
    "key": "shift+cmd+p",
    "command": "workbench.action.showCommands",
    "when": "composerFocused || focusedView =~ /^workbench.panel.aichat.view/",
  },

  // https://github.com/JacksonKearl/vscode-search-editor-apply-changes?tab=readme-ov-file#keybindings
  {
    "key": "cmd+s",
    "command": "searchEditorApplyChanges.apply",
    "when": "inSearchEditor",
  },
  {
    "key": "shift+enter",
    "command": "workbench.action.terminal.sendSequence",
    "args": {
      "text": "\\\r\n",
    },
    "when": "terminalFocus",
  },

  // Agent terminal + Shift+Cmd+[ / ]: Cursor does not provide workbench.action.terminal.focusPreviousGroup
  // or focusNextGroup. Use terminal tab switching instead (focusPrevious / focusNext), or find the
  // correct command in Cmd+Shift+P → "Keyboard Shortcuts" by searching "terminal focus".
  {
    "key": "shift+cmd+[",
    "command": "workbench.action.terminal.focusPrevious",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus || terminalFocus && !terminalEditorFocus"
  },
  {
    "key": "shift+cmd+]",
    "command": "workbench.action.terminal.focusNext",
    "when": "terminalFocus && terminalHasBeenCreated && !terminalEditorFocus || terminalFocus && terminalProcessSupported && !terminalEditorFocus || terminalFocus && !terminalEditorFocus"
  },
  {
    "key": "cmd+i",
    "command": "composerMode.agent",
  },
  {
    "key": "cmd+x",
    "command": "-workbench.action.showCommands",
    "when": "config.emacs-mcx.useMetaPrefixMacCmd && !findInputFocussed && !replaceInputFocussed"
  },
  {
    "key": "alt+cmd+s",
    "command": "workbench.action.toggleUnifiedSidebarFromKeyboard",
    "when": "cursor.agentIdeUnification.enabled == true && !isAuxiliaryWindowFocusedContext"
  },
]

// NOTES:

// CHECK CURRENT SETTINGS (run these commands to see current values):
// defaults read -g ApplePressAndHoldEnabled                                    // check press-and-hold setting
// defaults read NSGlobalDomain NSAutomaticPeriodSubstitutionEnabled            // check double-space period
// defaults read -g KeyRepeat                                                   // check key repeat rate
// defaults read -g InitialKeyRepeat                                            // check key repeat delay
//
// ORIGINAL macOS DEFAULTS (before any changes):
// - ApplePressAndHoldEnabled: true (1) - press-and-hold shows accent menu by default
// - NSAutomaticPeriodSubstitutionEnabled: true (1) - double-space inserts period by default
// - KeyRepeat: 6 (medium speed) - typical default repeat rate (UI range: 2-120, lower = faster)
// - InitialKeyRepeat: 25 (medium delay) - typical default delay before repeat starts (UI range: 15-300, lower = shorter)
//
// MINIMUM VALUES (via defaults, below UI minimums):
// - KeyRepeat: 1 is the absolute fastest (UI minimum is 2, but 1 works via defaults)
// - InitialKeyRepeat: 1 is the absolute shortest (UI minimum is 15, but 1 works via defaults)
//
// NOTE: If a setting returns "does not exist", it means it's using the system default.
// To reset to defaults: defaults delete -g SettingName
//
// CURRENT STATE (as of last check):
// - ApplePressAndHoldEnabled: 0 (false) - modified from default
// - NSAutomaticPeriodSubstitutionEnabled: 0 (false) - modified from default
// - KeyRepeat: 1 (fastest, absolute minimum) - modified from default
// - InitialKeyRepeat: 1 (shortest, absolute minimum, below UI min of 15) - modified from default

// READ CURRENT VALUES FIRST:
// defaults read -g KeyRepeat                                                   // check current repeat rate (lower = faster, 1 = fastest)
// defaults read -g InitialKeyRepeat                                           // check current repeat delay (lower = shorter, 1 = shortest)
//
// NOTE: UI minimums are KeyRepeat=2 and InitialKeyRepeat=15, but via defaults we can set:
// - KeyRepeat: 1 is the absolute fastest (cannot go lower)
// - InitialKeyRepeat: 1 is the absolute shortest delay (below UI minimum, may cause very fast repeats)
//
// IMPORTANT: After running defaults write commands, you MUST apply changes by:
// 1. Log out and back in (fastest method), OR
// 2. Restart your Mac, OR
// 3. Restart loginwindow: killall loginwindow (less disruptive, but may close some apps)
// The settings are written immediately, but won't take effect until you restart the session.

