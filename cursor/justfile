# Cursor config + skills management recipes
#
# Layers:
#   agent-skills  — authoring SoT (~/projects/agent-skills)
#   skill-*       — mirror live installs into dotfiles (commit locally; does not push)
#   compendium-*  — private ops DR at CURSOR_COMPENDIUM_ROOT (snapshot commits + pushes)
#
# Run `just` (or `just help`) for the list. Requires: bash, git, rsync, python3.
# Optional: gh (privacy checks).

set shell := ["bash", "-eu", "-o", "pipefail", "-c"]
set unstable := true

cursor_dir := justfile_directory()
dotfiles   := parent_directory(cursor_dir)
compendium := env_var_or_default("CURSOR_COMPENDIUM_ROOT", cursor_dir / "compendium")
agent_skills := env_var_or_default("AGENT_SKILLS_ROOT", home_directory() / "projects" / "agent-skills")
scripts    := cursor_dir / "scripts"
mirror     := cursor_dir / "compendium/mirrors/skills-snapshots"
inventory  := compendium / "skills-registry/skills-inventory.json"

# List recipes by group (skills = local commit; compendium = private GH push)
default:
    @just --list --list-heading $'Cursor recipes — skills commit in dotfiles (no push); compendium-backup pushes ops DR:\n'

alias help := default

# ------------------------------------------------------------------
# Status
# ------------------------------------------------------------------

# High-level status (git, skills, remotes privacy)
[group('status')]
status: git-status skill-status remotes
    @echo ""
    @echo "Tip: 'just compendium-backup' for ops DR (commit+push)."
    @echo "Tip: 'just skill-backup' for global skill mirrors in dotfiles (commit only)."

# Git status for dotfiles and the sibling ops compendium repo
[group('status')]
git-status:
    @echo "== git: dotfiles ({{dotfiles}}) =="
    @git -C "{{dotfiles}}" status --short --branch | head -20 || true
    @echo ""
    @echo "== git: compendium ({{compendium}}) =="
    @if [[ -d "{{compendium}}/.git" ]]; then git -C "{{compendium}}" status --short --branch | head -20; else echo "(no compendium git repo at {{compendium}}; set CURSOR_COMPENDIUM_ROOT)"; fi

# Skills counts (live vs dotfiles scaffold mirror) and last snapshot time
[group('status')]
skill-status:
    @echo "== skills =="
    @printf "live   ~/.cursor/skills        : %s\n" "$(ls -1 ~/.cursor/skills 2>/dev/null | wc -l | tr -d ' ')"
    @printf "live   ~/.cursor/skills-cursor : %s\n" "$(ls -1 ~/.cursor/skills-cursor 2>/dev/null | wc -l | tr -d ' ')"
    @printf "live   ~/.agents/skills        : %s\n" "$(ls -1 ~/.agents/skills 2>/dev/null | wc -l | tr -d ' ')"
    @printf "mirror skills                  : %s\n" "$(ls -1 '{{mirror}}/skills' 2>/dev/null | wc -l | tr -d ' ')"
    @printf "mirror skills-cursor           : %s\n" "$(ls -1 '{{mirror}}/skills-cursor' 2>/dev/null | wc -l | tr -d ' ')"
    @printf "mirror agents-skills           : %s\n" "$(ls -1 '{{mirror}}/agents-skills' 2>/dev/null | wc -l | tr -d ' ')"
    @if [[ -f "{{inventory}}" ]]; then printf "inventory generated            : %s\n" "$(python3 -c 'import json;print(json.load(open("{{inventory}}"))["generated"])' 2>/dev/null || echo unknown)"; else echo "inventory                      : (none; run 'just skill-discover')"; fi
    @printf "last mirror commit             : %s\n" "$(git -C "{{dotfiles}}" log -1 --format='%cs %h %s' -- cursor/compendium/mirrors/skills-snapshots 2>/dev/null || echo none)"

# Show live-vs-mirror drift (which skills changed since last skill-backup)
[group('status')]
skill-drift:
    #!/usr/bin/env bash
    set -uo pipefail
    echo "== drift: live vs mirror (rsync dry-run; empty = in sync) =="
    excl=(--exclude '.git/' --exclude '__pycache__/' --exclude '*.pyc' --exclude '.DS_Store' --exclude 'node_modules/')
    check() {
      local live="$1" dst="$2"
      [[ -d "$live" ]] || return 0
      echo "-- $dst --"
      rsync -rniL --delete "${excl[@]}" "$live/" "{{mirror}}/$dst/" 2>/dev/null | head -30
    }
    check ~/.cursor/skills        skills
    check ~/.cursor/skills-cursor skills-cursor
    check ~/.agents/skills        agents-skills

# Verify GitHub remotes for dotfiles + ops compendium are PRIVATE (no push)
[group('status')]
remotes:
    @echo "== remote privacy =="
    @"{{scripts}}/verify-private-remotes.sh" || true

alias verify-private := remotes

# ------------------------------------------------------------------
# Skills (dotfiles mirror — commit only, does not push)
# ------------------------------------------------------------------

# Mirror global skills, refresh inventory, commit in dotfiles (does not push)
[group('skills')]
skill-backup: skill-snapshot _skill-commit

# Same as skill-backup but skip project inventory scan (does not push)
[group('skills')]
skill-backup-fast:
    @SKILL_DISCOVER=0 CURSOR_COMPENDIUM_ROOT="{{cursor_dir}}/compendium" "{{scripts}}/snapshot-all-skills.sh"
    @just _skill-commit

# Mirror + inventory only into scaffold; no commit
[group('skills')]
skill-snapshot:
    @CURSOR_COMPENDIUM_ROOT="{{cursor_dir}}/compendium" "{{scripts}}/snapshot-all-skills.sh"

# Include project-local skills into CURSOR_COMPENDIUM_ROOT; prefer compendium-backup for push
[group('skills')]
skill-backup-full:
    @SNAPSHOT_PROJECT_SKILLS=1 CURSOR_COMPENDIUM_ROOT="{{compendium}}" "{{scripts}}/snapshot-all-skills.sh"
    @echo "Wrote under {{compendium}}. Prefer 'just compendium-backup' for full ops snapshot+push."

# Regenerate skills inventory under CURSOR_COMPENDIUM_ROOT (shim → agent-skills discover)
[group('skills')]
skill-discover:
    @python3 "{{agent_skills}}/scripts/discover-skills.py" --compendium-root "{{compendium}}"

# (internal) stage the mirror+inventory and commit if changed — does not push
[private]
_skill-commit:
    #!/usr/bin/env bash
    set -euo pipefail
    cd "{{dotfiles}}"
    git add cursor/compendium/mirrors/skills-snapshots cursor/compendium/skills-registry/skills-inventory.json cursor/compendium/skills-registry/skills-inventory.md 2>/dev/null || true
    if git diff --cached --quiet; then
      echo "No skill changes to commit."
    else
      git commit -m "chore(skills): snapshot $(date +%Y-%m-%d)"
      echo "Committed skill snapshot to dotfiles (not pushed)."
    fi

# ------------------------------------------------------------------
# Compendium (ops DR — commit + push to private GH)
# ------------------------------------------------------------------

# Snapshot ops CURSOR_COMPENDIUM_ROOT and commit+push (COMPENDIUM_AUTO_PUSH=0 to skip push)
[group('compendium')]
compendium-backup:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{compendium}}"
    if [[ ! -x "${root}/scripts/snapshot-all.sh" ]]; then
      echo "compendium-backup: missing ${root}/scripts/snapshot-all.sh" >&2
      echo "Set CURSOR_COMPENDIUM_ROOT to ~/ops/dotfiles-cursor-compendium" >&2
      exit 1
    fi
    if [[ ! -d "${root}/.git" ]]; then
      echo "compendium-backup: ${root} is not a git repo (scaffold-only?). Use the live ops tree." >&2
      exit 1
    fi
    export CURSOR_COMPENDIUM_ROOT="${root}"
    "${root}/scripts/snapshot-all.sh"

# Commit+push ops tree without re-running snapshot (privacy check included)
[group('compendium')]
compendium-push:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{compendium}}"
    export CURSOR_COMPENDIUM_ROOT="${root}"
    "${root}/scripts/commit-and-push.sh"

# Short git status for the ops compendium only
[group('compendium')]
compendium-status:
    @if [[ -d "{{compendium}}/.git" ]]; then git -C "{{compendium}}" status --short --branch; else echo "(no git repo at {{compendium}})"; fi

# Sync canonical scaffold scripts into the ops compendium (run after editing compendium/scripts/)
[group('compendium')]
compendium-sync-scripts:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{compendium}}"
    src="{{cursor_dir}}/compendium/scripts"
    if [[ ! -d "${root}/.git" ]]; then
      echo "compendium-sync-scripts: ${root} is not the ops git repo; set CURSOR_COMPENDIUM_ROOT" >&2
      exit 1
    fi
    rsync -a --exclude '__pycache__/' --exclude '*.pyc' "${src}/" "${root}/scripts/"
    if diff -rq -x '__pycache__' -x '*.pyc' "${src}" "${root}/scripts" >/dev/null 2>&1; then
      echo "Synced ${src}/ -> ${root}/scripts/ (trees match)."
    else
      echo "Synced ${src}/ -> ${root}/scripts/ (ops has extra local files; scaffold files are current):"
      diff -rq -x '__pycache__' -x '*.pyc' "${src}" "${root}/scripts" | sed 's/^/  /' || true
    fi

