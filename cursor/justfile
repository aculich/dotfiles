unpatch-raycast-cursor:
    @python3 "{{scripts}}/patch-raycast-cursor-classic.py" --undo

# Retired: Store JS rewrite is rejected by Raycast integrity checks
[group('config')]
patch-raycast-cursor:
    @python3 "{{scripts}}/patch-raycast-cursor-classic.py"

