# ------------------------------------------------------------------
# Automation
# ------------------------------------------------------------------

# Install daily LaunchAgent: ops compendium snapshot+push at 06:00
[group('automation')]
install-compendium-daily:
    #!/usr/bin/env bash
    set -euo pipefail
    root="{{compendium}}"
    if [[ ! -d "${root}/.git" ]]; then
      echo "install-compendium-daily: ${root} is not a git repo; set CURSOR_COMPENDIUM_ROOT" >&2
      exit 1
    fi
    plist=~/Library/LaunchAgents/com.user.cursor-compendium-daily.plist
    python3 - "$plist" "$root" <<'PY'
    import pathlib, sys, xml.sax.saxutils as x
    plist, root = pathlib.Path(sys.argv[1]), sys.argv[2]
    cmd = f'export CURSOR_COMPENDIUM_ROOT={root}; cd "$CURSOR_COMPENDIUM_ROOT" && ./scripts/snapshot-all.sh'
    escaped = x.escape(cmd)
    plist.write_text(
        '<?xml version="1.0" encoding="UTF-8"?>\n'
        '<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" '
        '"http://www.apple.com/DTDs/PropertyList-1.0.dtd">\n'
        '<plist version="1.0">\n'
        '<dict>\n'
        '  <key>Label</key>\n'
        '  <string>com.user.cursor-compendium-daily</string>\n'
        '  <key>ProgramArguments</key>\n'
        '  <array>\n'
        '    <string>/bin/bash</string>\n'
        '    <string>-lc</string>\n'
        f'    <string>{escaped}</string>\n'
        '  </array>\n'
        '  <key>StartCalendarInterval</key>\n'
        '  <dict>\n'
        '    <key>Hour</key>\n'
        '    <integer>6</integer>\n'
        '    <key>Minute</key>\n'
        '    <integer>0</integer>\n'
        '  </dict>\n'
        '  <key>StandardOutPath</key>\n'
        '  <string>/tmp/cursor-compendium-daily.log</string>\n'
        '  <key>StandardErrorPath</key>\n'
        '  <string>/tmp/cursor-compendium-daily.err</string>\n'
        '</dict>\n'
        '</plist>\n'
    )
    PY
    launchctl bootout "gui/$(id -u)/com.user.cursor-compendium-daily" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    echo "Installed daily ops compendium snapshot+push at 06:00 -> $plist"
    echo "Logs: /tmp/cursor-compendium-daily.log (.err)"

# Remove the daily ops compendium LaunchAgent
[group('automation')]
uninstall-compendium-daily:
    @launchctl bootout "gui/$(id -u)/com.user.cursor-compendium-daily" 2>/dev/null || true
    @rm -f ~/Library/LaunchAgents/com.user.cursor-compendium-daily.plist
    @echo "Removed daily ops compendium agent."

# Show status of the daily ops compendium LaunchAgent
[group('automation')]
compendium-daily-status:
    @launchctl print "gui/$(id -u)/com.user.cursor-compendium-daily" 2>/dev/null | grep -E "state|program|pid" || echo "not installed (run 'just install-compendium-daily')"

# Install a daily launchd agent that runs `just skill-backup` at 06:15 (dotfiles commit only)
[group('automation')]
install-daily:
    #!/usr/bin/env bash
    set -euo pipefail
    plist=~/Library/LaunchAgents/com.user.cursor-skill-backup.plist
    just_bin="$(command -v just)"
    cat > "$plist" <<PLIST
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>Label</key><string>com.user.cursor-skill-backup</string>
      <key>ProgramArguments</key>
      <array>
        <string>${just_bin}</string>
        <string>--justfile</string>
        <string>{{justfile()}}</string>
        <string>skill-backup</string>
      </array>
      <key>StartCalendarInterval</key>
      <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>15</integer></dict>
      <key>StandardOutPath</key><string>/tmp/cursor-skill-backup.log</string>
      <key>StandardErrorPath</key><string>/tmp/cursor-skill-backup.err</string>
    </dict>
    </plist>
    PLIST
    launchctl bootout "gui/$(id -u)/com.user.cursor-skill-backup" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$plist"
    echo "Installed daily skill-backup at 06:15 -> $plist"
    echo "Logs: /tmp/cursor-skill-backup.log (.err)"

# Remove the daily skill-backup LaunchAgent
[group('automation')]
uninstall-daily:
    @launchctl bootout "gui/$(id -u)/com.user.cursor-skill-backup" 2>/dev/null || true
    @rm -f ~/Library/LaunchAgents/com.user.cursor-skill-backup.plist
    @echo "Removed daily skill-backup agent."

# Show status of the daily skill-backup LaunchAgent
[group('automation')]
daily-status:
    @launchctl print "gui/$(id -u)/com.user.cursor-skill-backup" 2>/dev/null | grep -E "state|program|pid" || echo "not installed (run 'just install-daily')"
