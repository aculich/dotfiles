{
  "redhat.telemetry.enabled": true,
  "yaml.schemas": {
    "file:///Users/me/.vscode/extensions/continue.continue-1.2.3-darwin-arm64/config-yaml-schema.json": [
      ".continue/**/*.yaml",
    ],
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "project-scopes.globalExclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true,
  },
  "editor.accessibilitySupport": "off",
  "docker.extension.enableComposeLanguageServer": false,
  "makefile.configureOnOpen": true,
  "specstory.cloudSync.enabled": "always",
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
  "python.terminal.useEnvFile": true,
  "git.path": "/opt/homebrew/bin/git",
  "git.autofetch": false,
  "claudeCode.preferredLocation": "panel",
  "specstory.derivedRules.enabled": false,
  "workbench.colorTheme": "Tomorrow Night Blue",
  "zenMode.restore": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
  "cSpell.enabled": false,
  "remote.SSH.remotePlatform": {
    "klein.berkeley.edu": "linux",
  },
  "claudeCode.useTerminal": true,
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.initialPermissionMode": "bypassPermissions",
  "claudeCode.claudeProcessWrapper": "/Users/me/.local/bin/claude-code-cursor-wrapper.sh",
  "terminal.integrated.macOptionIsMeta": true,
  "magit.forge-enabled": true,
  "magit.display-buffer-function": "same-column",
  "magit.quick-switch-enabled": true,
  "gitTreeCompare.diffMode": "full",
  "update.releaseTrack": "dev",
  "update.mode": "silentlyApplyOnQuit",
  "githubPullRequests.pullBranch": "never",
  "cursor.terminal.usePreviewBox": true,
  "window.autoDetectColorScheme": false,
  "workbench.editor.enablePreview": false,
  "git.blame.statusBarItem.enabled": true,
  "git.blame.editorDecoration.enabled": false,
  "workbench.editorAssociations": {
    "*.md": "vscode.markdown.preview.editor"
  },
  "specstory.providers.enabled": {
    "Copilot IDE": false,
    "Factory Droid CLI": false,
    "Codex CLI": false,
    "DeepSeek TUI": false
  },
  "specstory.helpUsImprove": false,
  "chatstory.gitSync.enabled": true,
  "chatstory.showDeveloperTools": true
}
