<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.user.cursor-compendium-daily</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-lc</string>
    <string>export CURSOR_COMPENDIUM_ROOT=/Users/me/src/dotfiles-cursor-compendium; cd "$CURSOR_COMPENDIUM_ROOT" &amp;&amp; ./scripts/snapshot-all.sh &amp;&amp; git add -A &amp;&amp; (git diff --cached --quiet || git commit -m "chore(compendium): daily snapshot $(date +%Y-%m-%d)")</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/tmp/cursor-compendium-daily.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/cursor-compendium-daily.err</string>
</dict>
</plist>
