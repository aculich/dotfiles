{
  "redhat.telemetry.enabled": true,
  "yaml.schemas": {
    "file:///Users/me/.vscode/extensions/continue.continue-1.2.3-darwin-arm64/config-yaml-schema.json": [
      ".continue*.yaml"
    ]
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "project-scopes.globalExclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/.DS_Store": true,
    "**/Thumbs.db": true
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/node_modules/**": true,
    "**/.venv/**": true,
    "**/.venv-*/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.pytest_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.tox/**": true,
    "**/.nox/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/.specstory/**": true,
    "**/upstream/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.venv": true,
    "**/.venv-*": true,
    "**/__pycache__": true,
    "**/.mypy_cache": true,
    "**/.pytest_cache": true,
    "**/.ruff_cache": true,
    "**/.tox": true,
    "**/.nox": true,
    "**/dist": true,
    "**/build": true,
    "**/.specstory": true,
    "**/upstream": true
  },
  "editor.accessibilitySupport": "off",
  "docker.extension.enableComposeLanguageServer": false,
  "makefile.configureOnOpen": true,
  "python.defaultInterpreterPath": "/opt/homebrew/bin/python3",
  "python.terminal.useEnvFile": true,
  "git.path": "/opt/homebrew/bin/git",
  "git.autofetch": false,
  "claudeCode.preferredLocation": "panel",
  "specstory.derivedRules.enabled": false,
  "workbench.colorTheme": "Solarized Light",
  "zenMode.restore": false,
  "terminal.integrated.persistentSessionReviveProcess": "never",
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*"
  },
  "cSpell.enabled": false,
  "remote.SSH.remotePlatform": {
    "klein.berkeley.edu": "linux"
  },
  "claudeCode.useTerminal": true,
  "claudeCode.allowDangerouslySkipPermissions": true,
  "claudeCode.initialPermissionMode": "bypassPermissions",
  "claudeCode.claudeProcessWrapper": "/Users/me/.local/bin/claude-code-cursor-wrapper.sh",
  "terminal.integrated.macOptionIsMeta": true,
  "magit.forge-enabled": true,
  "magit.display-buffer-function": "same-column",
  "magit.quick-switch-enabled": true,
  "gitTreeCompare.diffMode": "full",
  "update.releaseTrack": "dev",
  "update.mode": "silentlyApplyOnQuit",
  "githubPullRequests.pullBranch": "never",
  "cursor.terminal.usePreviewBox": true,
  "window.autoDetectColorScheme": false,
  "workbench.editor.enablePreview": false,
  "workbench.editorAssociations": {
    "*.md": "default"
  },
  "editor.minimap.enabled": true,
  "editor.renderWhitespace": "none",
  "editor.semanticHighlighting.enabled": false,
  "git.blame.statusBarItem.enabled": true,
  "git.blame.editorDecoration.enabled": false,
  "specstory.providers.enabled": {
    "Copilot IDE": false,
    "Factory Droid CLI": false,
    "Codex CLI": false,
    "DeepSeek TUI": false
  },
  "specstory.helpUsImprove": false,
  "chatstory.gitSync.enabled": true,
  "chatstory.showDeveloperTools": true,
  "vim.easymotion": true,
  "vim.useSystemClipboard": true,
  "vim.useCtrlKeys": true,
  "vim.incsearch": true,
  "vim.hlsearch": true,
  "vim.ignorecase": true,
  "vim.smartcase": true,
  "vim.handleKeys": {
    "<C-d>": true,
    "<C-s>": false,
    "<C-r>": false,
    "<C-w>": false,
    "<C-x>": false,
    "<C-y>": false,
    "<C-z>": false
  },
  "vim.normalModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<space>"
      ],
      "commands": [
        "vspacecode.space"
      ]
    },
    {
      "before": [
        ","
      ],
      "commands": [
        "vspacecode.space",
        {
          "command": "whichkey.triggerKey",
          "args": "m"
        }
      ]
    },
    {
      "before": [
        "f"
      ],
      "commands": [
        "flash-vscode.start"
      ]
    },
    {
      "before": [
        "F"
      ],
      "commands": [
        "flash-vscode.startSelection"
      ]
    },
    {
      "before": [
        "t"
      ],
      "commands": [
        "flash-vscode.jump.treesitterSelection"
      ]
    },
    {
      "before": [
        "T"
      ],
      "commands": [
        "flash-vscode.remoteTreesitterSelection"
      ]
    },
    {
      "before": [
        "<BS>"
      ],
      "commands": [
        "flash-vscode.backspace"
      ]
    },
    {
      "before": [
        "<Esc>"
      ],
      "commands": [
        "flash-vscode.exit"
      ]
    }
  ],
  "vim.visualModeKeyBindingsNonRecursive": [
    {
      "before": [
        "<space>"
      ],
      "commands": [
        "vspacecode.space"
      ]
    },
    {
      "before": [
        ","
      ],
      "commands": [
        "vspacecode.space",
        {
          "command": "whichkey.triggerKey",
          "args": "m"
        }
      ]
    },
    {
      "before": [
        ">"
      ],
      "commands": [
        "editor.action.indentLines"
      ]
    },
    {
      "before": [
        "<"
      ],
      "commands": [
        "editor.action.outdentLines"
      ]
    }
  ],
  "vspacecode.bindingOverrides": [
    {
      "keys": "j.f",
      "name": "Flash: jump",
      "icon": "zap",
      "type": "command",
      "command": "flash-vscode.start"
    },
    {
      "keys": "j.F",
      "name": "Flash: selection jump",
      "icon": "selection",
      "type": "command",
      "command": "flash-vscode.startSelection"
    },
    {
      "keys": "j.t",
      "name": "Flash: treesitter scope",
      "icon": "symbol-structure",
      "type": "command",
      "command": "flash-vscode.jump.treesitterSelection"
    },
    {
      "keys": "j.T",
      "name": "Flash: remote treesitter",
      "icon": "remote",
      "type": "command",
      "command": "flash-vscode.remoteTreesitterSelection"
    },
    {
      "keys": "j.s",
      "name": "Flash: symbol jump",
      "icon": "symbol-method",
      "type": "command",
      "command": "flash-vscode.jump.symbol"
    },
    {
      "keys": "j.b",
      "name": "Jump back (Vim jumplist)",
      "icon": "arrow-left",
      "type": "command",
      "command": "extension.vim_ctrl+o"
    },
    {
      "keys": "j.e",
      "name": "Go to last edit location",
      "icon": "history",
      "type": "command",
      "command": "workbench.action.navigateToLastEditLocation"
    }
  ],
  "emacs-mcx.strictEmacsMove": false,
  "emacs-mcx.enableDigitArgument": false,
  "vim.overrideCopy": false,
  "emacs-mcx.useMetaPrefixMacCmd": false,
  "emacs-mcx.useMetaPrefixAlt": true,
  "git.enableSmartCommit": true,
  "vim.disableExtension": false,
  "cursor.composer.conversationDensity": "detailed",
  "cursor.general.emailPrivacyEnabled": true,
  "workbench.reduceMotion": "off",
  "cursor.general.glassShowWarningNotifications": true,
  "cursor.composer.shouldChimeAfterChatFinishes": true,
  "workbench.preferredHighContrastColorTheme": "Tomorrow Night Blue",
  "yaml.disableSchemaDetection": [
    "**/.github/workflows/*.yml",
    "**/.github/workflows/*.yaml",
    "**/.gitea/workflows/*.yml",
    "**/.gitea/workflows/*.yaml",
    "**/.forgejo/workflows/*.yml",
    "**/.forgejo/workflows/*.yaml"
  ],
  "files.associations": {
    "*.txt": "markdown"
  },
  "cursorToys.projects.enabled": true,
  "cursorToys.projects.openDashboardOnStartup": false,
  "cursorToys.projects.openInNewWindow": true,
  "cursorToys.cursorPet.enabled": false,
  "cursorToys.cursorPet.showStatusBar": false,
  "cursorToys.notepads.showStatusBar": true,
  "cursorToys.cli.cursortoysPackageSpec": "@latest",
  "cursorToys.sidebar.hiddenViews": [
    "notepads",
    "kanban",
    "clipboard",
    "commands",
    "prompts",
    "plans",
    "skills",
    "hooks",
    "mcpb",
    "http",
    "inlineAnnotations"
  ],
  "cursorToys.releaseNotes.showOnStartup": false,
  "cursorToys.kanban.showStatusBar": true,
  "cursorToys.clipboard.bindStandardKeys": false,
  "cursorToys.clipboard.enabled": false,
  "cursorToys.clipboard.syncWithSystem": false,
  "cursorToys.gistDefaultVisibility": "ask",
  "cursorToys.inlineAnnotations.updateOnType": false,
  "cursorToys.sidebar.explorerViews": [
    "notepads",
    "kanban",
    "clipboard",
    "commands",
    "prompts",
    "plans",
    "skills",
    "hooks",
    "mcpb",
    "http",
    "inlineAnnotations"
  ],
  "cursorToys.personalCommandsView": "both",
  "cursorToys.allowedExtensions": [
    "md",
    "mdc",
    "txt",
    "json",
    "req",
    "request"
  ]
}
