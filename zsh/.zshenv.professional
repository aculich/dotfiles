#!/usr/bin/env zsh
# .zshenv - Sourced for ALL zsh invocations (even non-interactive)
# Keep this minimal - only essential PATH and environment setup
# Last updated: 2025-11-28

# ============================================================================
# ESSENTIAL PATH SETUP
# ============================================================================
# Homebrew (Apple Silicon first, then Intel)
# Use explicit PATH addition as fallback to ensure it works in all environments
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
    # Explicitly add Homebrew bin to PATH as fallback
    [[ ":$PATH:" != *":/opt/homebrew/bin:"* ]] && export PATH="/opt/homebrew/bin:$PATH"
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
    # Explicitly add Homebrew bin to PATH as fallback
    [[ ":$PATH:" != *":/usr/local/bin:"* ]] && export PATH="/usr/local/bin:$PATH"
fi

# User local bin (pipx, etc.)
export PATH="$HOME/.local/bin:$PATH"

# Anaconda/Miniconda bin directory (for tools like yt-dlp)
# Add to PATH without full conda initialization for faster startup
if [[ -d /opt/anaconda3/bin ]]; then
    export PATH="/opt/anaconda3/bin:$PATH"
elif [[ -d "$HOME/anaconda3/bin" ]]; then
    export PATH="$HOME/anaconda3/bin:$PATH"
elif [[ -d "$HOME/miniconda3/bin" ]]; then
    export PATH="$HOME/miniconda3/bin:$PATH"
fi

# ============================================================================
# BASIC ENVIRONMENT VARIABLES
# ============================================================================
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# Editor (for git commits, etc.)
export EDITOR="${EDITOR:-code}"

# Function nesting limit (prevents "maximum nested function level" errors)
# NVM and other tools use deeply nested function calls, so we need a higher limit
# Default is usually 50, but nvm can exceed this
export FUNCNEST=100

# ============================================================================
# 1PASSWORD DEFAULT ACCOUNT
# ============================================================================
# Set default 1Password account to use for CLI operations
# This ensures all op commands use the correct account when multiple are configured
export OP_DEFAULT_ACCOUNT="aculich@gmail.com"
export OP_ACCOUNT="aculich@gmail.com"

