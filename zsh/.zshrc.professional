# ============================================================================
# TERMINAL INTEGRATIONS
# ============================================================================
_zsh_profile_section "TERMINAL INTEGRATIONS"

# IDE Terminal Optimizations (Cursor, VSCode, Antigravity)
if [[ "$IS_IDE_TERMINAL" == true ]]; then
    # Ensure proper shell detection
    export SHELL="/bin/zsh"
    
    # Disable pager in IDE terminals (faster, cleaner output)
    export GIT_PAGER='cat'
    
    # Skip heavy Oh My Zsh features in IDE terminals
    # (We already loaded Oh My Zsh, but we can optimize further)
    # Note: We still load plugins, but they're lighter in IDE context
    
    # Don't load 1Password secrets automatically in IDE terminals
    # (User can load manually if needed: op_load_item "Development" "Development API Keys")
fi

# iTerm2 shell integration
[[ -f "$HOME/.iterm2_shell_integration.zsh" ]] && source "$HOME/.iterm2_shell_integration.zsh"

# Raycast shell aliases (if exists)
[[ -f "$HOME/.raycast_shell_aliases" ]] && source "$HOME/.raycast_shell_aliases"

# ============================================================================
# COMPLETION SETUP
# ============================================================================
_zsh_profile_section "COMPLETION SETUP"

# WHAT COMPLETION DOES:
# The zsh completion system provides intelligent tab-completion for commands,
# arguments, options, and file paths. It's one of zsh's most powerful features.
#
# PERFORMANCE IMPACT:
# - compinit: ~590ms (21% of startup) - Initializes completion system
# - compdump: ~257ms (9% of startup) - Loads cached completion definitions
# - Total: ~850ms (30% of startup time)
#
# WHY IT'S IMPORTANT:
# - Saves significant time during daily use (tab completion is used constantly)
# - Prevents typos and errors in commands
# - Provides discoverability of command options
# - Worth the startup cost for the productivity gains
#
# OPTIMIZATION STRATEGY:
# 1. Cache completion definitions (compdump) - only regenerate if >24h old
# 2. Skip security checks with -C flag when cache is fresh (saves ~100ms)
# 3. Load only essential completions (Docker, etc.) - avoid loading unused ones
# 4. Consider lazy-loading completions for rarely-used tools

# Add custom completion directories to fpath (before compinit)
# Docker completions (if installed)
if [[ -d "$HOME/.docker/completions" ]]; then
    fpath=("$HOME/.docker/completions" $fpath)
fi

# Initialize completion system
autoload -Uz compinit

# Performance optimization: Only regenerate compdump if older than 24 hours
# - compinit: Full initialization with security checks (~590ms)
# - compinit -C: Skip security checks, use cached compdump (~100ms faster)
# The glob qualifier (#qN.mh+24) checks if file exists and is >24h old
if [[ ! -f "$HOME/.zcompdump" ]] || [[ -n "$HOME/.zcompdump"(#qN.mh+24) ]]; then
    # Cache is missing or stale (>24h old) - regenerate with full security checks
    # This takes longer (~590ms) but ensures completions are up-to-date
    compinit
else
    # Cache is fresh (<24h old) - use fast path with -C flag
    # This skips security checks and saves ~100ms (runs in ~490ms)
    compinit -C
fi

# ============================================================================
# HISTORY CONFIGURATION
# ============================================================================
_zsh_profile_section "HISTORY CONFIGURATION"

# WHAT HISTORY DOES:
# Zsh history stores your command-line commands, allowing you to:
# - Search through past commands (Ctrl+R, up/down arrows)
# - Reuse commands without retyping
# - Learn from your command patterns
# - Audit what commands were run (with timestamps)
#
# PERFORMANCE IMPACT:
# - History loading: ~20-50ms (minimal, but can grow with large history files)
# - History size: 10,000 entries is a good balance (not too large, not too small)
# - Large history files (>50k entries) can slow down history search
#
# WHY IT'S IMPORTANT:
# - Saves significant time by reusing commands
# - Prevents retyping long/complex commands
# - Provides command discovery and learning
# - Enables auditing with timestamps (EXTENDED_HISTORY)
#
# OPTIMIZATION STRATEGY:
# 1. Use reasonable history size (10k entries = ~2-3MB file)
# 2. Remove duplicates to keep history clean
# 3. Ignore space-prefixed commands (for sensitive operations)
# 4. Append immediately (INC_APPEND_HISTORY) instead of sharing (SHARE_HISTORY)
# 5. Enable extended history for timestamps (useful for auditing)

# History file location and size
export HISTFILE="$HOME/.zsh_history"
export HISTSIZE=10000   # Number of commands to keep in memory
export SAVEHIST=10000   # Number of commands to save to history file

# Core history options
setopt EXTENDED_HISTORY         # Save timestamps (format: ': <beginning time>:<elapsed seconds>;<command>')
                                # Enables auditing: 'history -E' shows full timestamps
                                # Example: ': 1704067200:0;ls -la'

setopt INC_APPEND_HISTORY       # Append commands to history file immediately (not on exit)
                                # Better than SHARE_HISTORY: each session has its own in-memory history
                                # but writes are shared, so you get benefits without session interference

# Duplicate handling (keeps history clean)
setopt HIST_IGNORE_DUPS         # Don't record duplicate commands (consecutive)
setopt HIST_IGNORE_ALL_DUPS     # Remove older duplicate entries, keeping only the latest
setopt HIST_EXPIRE_DUPS_FIRST   # Expire duplicate entries first when trimming history
setopt HIST_FIND_NO_DUPS        # Don't show duplicates in history search (Ctrl+R)

# Privacy and convenience
setopt HIST_IGNORE_SPACE        # Don't save commands that start with a space
                                # Useful for sensitive commands: ' secret-command' won't be saved

setopt HIST_REDUCE_BLANKS       # Remove unnecessary whitespace from history entries
                                # 'ls   -la' becomes 'ls -la' in history

setopt HIST_VERIFY              # Show command from history before executing
                                # Prevents accidental execution of wrong commands

# ============================================================================
# MISC CONFIGURATIONS
# ============================================================================
_zsh_profile_section "MISC CONFIGURATIONS"

# Locale
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# Editor
export EDITOR="${EDITOR:-code}"  # Use 'code' (VS Code/Cursor) as default
export VISUAL="$EDITOR"

# Git pager (respect IDE environment - already set above if IDE terminal)
if [[ "$IS_IDE_TERMINAL" != true ]]; then
    export GIT_PAGER='less -FRX'
fi

# ============================================================================
# POST-INITIALIZATION
# ============================================================================
_zsh_profile_section "POST-INITIALIZATION"
# Load powerlevel10k instant prompt if available (must be last)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Load p10k config if theme is powerlevel10k
if [[ "$ZSH_THEME" == "powerlevel10k/powerlevel10k" ]] && [[ -f "$HOME/.p10k.zsh" ]]; then
    source "$HOME/.p10k.zsh"
fi

# Display final startup time if profiling is enabled
if [[ "$ZSH_PROFILE_STARTUP" == "true" ]]; then
    local final_time
    local total_time
    
    if (( ${+EPOCHREALTIME} )); then
        final_time=${EPOCHREALTIME}
        total_time=$(( (final_time - ZSH_START_TIME) * 1000 ))
    else
        final_time=$SECONDS
        total_time=$(( (final_time - ZSH_START_TIME) * 1000 ))
    fi
    
    printf "Total startup time: %.3fms\n" "$total_time" >&2
fi