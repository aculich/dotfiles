#!/usr/bin/env zsh
# Professional Zsh Configuration
# Modular, maintainable, and secure setup for development environments
# Last updated: 2025-11-28

# ============================================================================
# STARTUP PROFILING CONFIGURATION
# ============================================================================
# Set to 'true' to display timing information for each section during startup
# Set to 'false' or unset to disable timing display
export ZSH_PROFILE_STARTUP="${ZSH_PROFILE_STARTUP:-true}"

# Initialize timing variables (must be very early)
if [[ "$ZSH_PROFILE_STARTUP" == "true" ]]; then
    # Use EPOCHREALTIME if available (zsh 5.3.4+), otherwise use SECONDS
    # EPOCHREALTIME is in seconds since epoch, SECONDS is seconds since shell start
    # Declare as global float variables
    typeset -gF ZSH_START_TIME
    typeset -gF ZSH_LAST_TIME
    
    if (( ${+EPOCHREALTIME} )); then
        # EPOCHREALTIME: capture current value explicitly
        ZSH_START_TIME=${EPOCHREALTIME}
        ZSH_LAST_TIME=${EPOCHREALTIME}
    else
        # SECONDS: already a float, starts at 0 when shell starts
        ZSH_START_TIME=$SECONDS
        ZSH_LAST_TIME=$SECONDS
    fi
    
    # Helper function to display timing
    _zsh_profile_section() {
        local section_name="$1"
        local current_time
        local elapsed
        local total_elapsed
        
        if (( ${+EPOCHREALTIME} )); then
            # EPOCHREALTIME: get current value and calculate difference
            current_time=${EPOCHREALTIME}
            # Calculate elapsed time in milliseconds
            elapsed=$(( (current_time - ZSH_LAST_TIME) * 1000 ))
            total_elapsed=$(( (current_time - ZSH_START_TIME) * 1000 ))
        else
            # SECONDS: already in seconds, calculate difference in milliseconds
            current_time=$SECONDS
            elapsed=$(( (current_time - ZSH_LAST_TIME) * 1000 ))
            total_elapsed=$(( (current_time - ZSH_START_TIME) * 1000 ))
        fi
        
        # Format: [section] elapsed: X.XXXms (total: Y.YYYms)
        printf "\033[0;36m[%s]\033[0m elapsed: \033[0;33m%.3fms\033[0m (total: \033[0;32m%.3fms\033[0m)\n" \
            "$section_name" "$elapsed" "$total_elapsed" >&2
        
        # Update global variable
        ZSH_LAST_TIME=$current_time
    }
    
    _zsh_profile_section "START"
else
    # Dummy function when profiling is disabled (no-op)
    _zsh_profile_section() { : }
fi

# ============================================================================
# INITIALIZATION ORDER
# ============================================================================
# This file follows the proper zsh initialization order:
# 1. .zshenv - Always sourced (even for non-interactive shells)
# 2. .zprofile - Sourced for login shells
# 3. .zshrc - Sourced for interactive shells (this file)
# 4. .zlogin - Sourced after .zshrc for login shells
# 5. .zlogout - Sourced when login shell exits

# ============================================================================
# FUNCTION NESTING LIMIT (Very early - before any tools that use nested functions)
# ============================================================================
_zsh_profile_section "FUNCTION NESTING LIMIT"
# Set FUNCNEST early to prevent "maximum nested function level" errors
# NVM and other tools use deeply nested function calls
# Default is usually 50, but nvm can exceed this
# Note: Also set in .zshenv, but ensure it's set here too for safety
export FUNCNEST="${FUNCNEST:-100}"

# ============================================================================
# PATH SETUP (Early - before other tools)
# ============================================================================
_zsh_profile_section "PATH SETUP"
# Homebrew (must be first for Apple Silicon)
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# Local bin directories (user-installed tools)
export PATH="$HOME/.local/bin:$PATH"

# ============================================================================
# OH-MY-ZSH SETUP
# ============================================================================
_zsh_profile_section "OH-MY-ZSH SETUP"
export ZSH="$HOME/.oh-my-zsh"

# Set theme (can be overridden by powerlevel10k if installed)
ZSH_THEME="${ZSH_THEME:-robbyrussell}"

# Plugins - carefully curated for performance
plugins=(
    git
#    direnv
    zsh-autosuggestions
    zsh-syntax-highlighting
    fzf
)

# Load Oh My Zsh
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
fi

# ============================================================================
# IDE DETECTION (VERY EARLY - before direnv and other tools)
# ============================================================================
_zsh_profile_section "IDE DETECTION"
# Detect if we're running in an IDE terminal (Cursor, VSCode, Antigravity)
# In IDE terminals, we use minimal config for fast startup
# MUST be before direnv hook and site-specific configs to prevent nvm calls
IS_IDE_TERMINAL=false
if [[ "$TERM_PROGRAM" == "cursor" ]] || \
   [[ "$TERM_PROGRAM" == "vscode" ]] || \
   [[ "$TERM_PROGRAM" == "antigravity" ]] || \
   [[ -n "$CURSOR_SHELL_INTEGRATION" ]] || \
   [[ -n "$VSCODE_INJECTION" ]]; then
    IS_IDE_TERMINAL=true
fi

# ============================================================================
# NVM WRAPPER SETUP (Before anything that might call nvm)
# ============================================================================
_zsh_profile_section "NVM WRAPPER SETUP"
# Set up NVM_DIR and create wrapper functions BEFORE direnv or site-specific configs
# This ensures nvm() is available even if something tries to call it early
export NVM_DIR="$HOME/.nvm"

# Helper function to load NVM (used by lazy loaders)
# Try multiple paths since nvm can be installed in different ways
_load_nvm() {
    # Try NVM_DIR first (standard nvm installation)
    if [[ -s "$NVM_DIR/nvm.sh" ]]; then
        source "$NVM_DIR/nvm.sh"
        return 0
    fi
    # Try brew prefix (if installed via Homebrew)
    if [[ -s "$(brew --prefix nvm)/nvm.sh" ]]; then
        source "$(brew --prefix nvm)/nvm.sh"
        return 0
    fi
    return 1
}

# Create nvm wrapper function early (before direnv or site-specific configs)
# This prevents "command not found: nvm" errors during startup
# IMPORTANT: Create wrapper for ALL terminals, not just IDE terminals
# Site-specific configs may call nvm before it's loaded
nvm() {
    # Check if NVM is already loaded by checking for nvm_find_nvmrc function
    # This function only exists after nvm.sh is loaded
    if ! type nvm_find_nvmrc &> /dev/null; then
        # NVM not loaded yet - remove this wrapper and load the real nvm
        unfunction nvm 2>/dev/null || true
        _load_nvm || return 1
        # After _load_nvm, nvm is now the real function from nvm.sh
        # Call it with the original arguments
        nvm "$@"
    else
        # NVM is already loaded - nvm should be the real function
        # But if we're still in the wrapper, something went wrong
        # Try to get the real nvm function
        if [[ "$(type nvm 2>/dev/null)" == *"_load_nvm"* ]] || [[ "$(type nvm 2>/dev/null)" == *"nvm() {"* ]]; then
            # We're still in the wrapper - force reload
            unfunction nvm 2>/dev/null || true
            _load_nvm || return 1
        fi
        # Call the real nvm function
        nvm "$@"
    fi
}

# Also create node/npm/npx wrappers for lazy loading in IDE terminals
if [[ "$IS_IDE_TERMINAL" == true ]]; then
    node() {
        # Load NVM if not already loaded
        if ! type nvm &> /dev/null; then
            _load_nvm || return 1
        fi
        # Remove wrapper functions (NVM is now loaded)
        unfunction node npm npx 2>/dev/null || true
        # Call the real node command
        command node "$@"
    }
    
    npm() {
        # Load NVM if not already loaded
        if ! type nvm &> /dev/null; then
            _load_nvm || return 1
        fi
        # Remove wrapper functions (NVM is now loaded)
        unfunction node npm npx 2>/dev/null || true
        # Call the real npm command
        command npm "$@"
    }
    
    npx() {
        # Load NVM if not already loaded
        if ! type nvm &> /dev/null; then
            _load_nvm || return 1
        fi
        # Remove wrapper functions (NVM is now loaded)
        unfunction node npm npx 2>/dev/null || true
        # Call the real npx command
        command npx "$@"
    }
fi

# ============================================================================
# DIRENV SETUP (Before other env tools)
# ============================================================================
_zsh_profile_section "DIRENV SETUP"
# Direnv must be hooked early to work with project-specific .envrc files
# Silence direnv verbose output for cleaner terminal
export DIRENV_LOG_FORMAT=""
if command -v direnv &> /dev/null; then
    eval "$(direnv hook zsh)"
fi

# ============================================================================
# CUSTOM CONFIGURATION MODULES
# ============================================================================
_zsh_profile_section "CUSTOM CONFIGURATION MODULES"
# Source modular configuration files from dotfiles repo
DOTFILES_ZSH="$HOME/dotfiles/zsh"

# Functions (load before aliases in case aliases use functions)
[[ -f "$DOTFILES_ZSH/functions.zsh" ]] && source "$DOTFILES_ZSH/functions.zsh"

# Aliases (loaded after Oh My Zsh so they can override plugin aliases)
[[ -f "$DOTFILES_ZSH/aliases.zsh" ]] && source "$DOTFILES_ZSH/aliases.zsh"

# # Environment-specific configs (site-specific, machine-specific)
# # NOTE: These configs might call nvm, so nvm wrapper must be defined above
# if [[ -d "$DOTFILES_ZSH/site-specific" ]]; then
#     # Source machine-specific config if it exists
#     MACHINE_ID=$(system_profiler SPHardwareDataType 2>/dev/null | grep "Hardware UUID" | awk '{print $3}')
#     [[ -n "$MACHINE_ID" && -f "$DOTFILES_ZSH/site-specific/.zshrc-$MACHINE_ID" ]] && \
#         source "$DOTFILES_ZSH/site-specific/.zshrc-$MACHINE_ID"
# fi

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================
_zsh_profile_section "DEVELOPMENT TOOLS"

# # Node Version Manager (nvm) - Already set up above for IDE terminals
