#!/usr/bin/env zsh
# Professional Zsh Configuration
# Modular, maintainable, and secure setup for development environments
# Last updated: 2025-11-28

# ============================================================================
# INITIALIZATION ORDER
# ============================================================================
# This file follows the proper zsh initialization order:
# 1. .zshenv - Always sourced (even for non-interactive shells)
# 2. .zprofile - Sourced for login shells
# 3. .zshrc - Sourced for interactive shells (this file)
# 4. .zlogin - Sourced after .zshrc for login shells
# 5. .zlogout - Sourced when login shell exits

# ============================================================================
# PATH SETUP (Early - before other tools)
# ============================================================================
# Homebrew (must be first for Apple Silicon)
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# Local bin directories (user-installed tools)
export PATH="$HOME/.local/bin:$PATH"

# ============================================================================
# OH-MY-ZSH SETUP
# ============================================================================
export ZSH="$HOME/.oh-my-zsh"

# Set theme (can be overridden by powerlevel10k if installed)
ZSH_THEME="${ZSH_THEME:-robbyrussell}"

# Plugins - carefully curated for performance
plugins=(
    git
    direnv
    zsh-autosuggestions
    zsh-syntax-highlighting
    fzf
)

# Load Oh My Zsh
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
fi

# ============================================================================
# IDE DETECTION (VERY EARLY - before direnv and other tools)
# ============================================================================
# Detect if we're running in an IDE terminal (Cursor, VSCode, Antigravity)
# In IDE terminals, we use minimal config for fast startup
# MUST be before direnv hook and site-specific configs to prevent nvm calls
IS_IDE_TERMINAL=false
if [[ "$TERM_PROGRAM" == "cursor" ]] || \
   [[ "$TERM_PROGRAM" == "vscode" ]] || \
   [[ "$TERM_PROGRAM" == "antigravity" ]] || \
   [[ -n "$CURSOR_SHELL_INTEGRATION" ]] || \
   [[ -n "$VSCODE_INJECTION" ]]; then
    IS_IDE_TERMINAL=true
fi

# ============================================================================
# NVM WRAPPER SETUP (Before anything that might call nvm)
# ============================================================================
# Set up NVM_DIR and create wrapper functions BEFORE direnv or site-specific configs
# This ensures nvm() is available even if something tries to call it early
export NVM_DIR="$HOME/.nvm"

# Helper function to load NVM (used by lazy loaders)
_load_nvm() {
    if [[ -s "$(brew --prefix nvm)/nvm.sh" ]]; then
        source "$(brew --prefix nvm)/nvm.sh"
        return 0
    fi
    return 1
}

# Create nvm wrapper function early (before direnv or site-specific configs)
# This prevents "command not found: nvm" errors during startup
if [[ "$IS_IDE_TERMINAL" == true ]]; then
    # In IDE terminals: create wrapper that lazy-loads NVM
    nvm() {
        # Load NVM if not already loaded
        if ! type nvm &> /dev/null || [[ "$(type nvm)" != *"function"* ]]; then
            _load_nvm || return 1
        fi
        # Call the real nvm function
        nvm "$@"
    }
    
    # Also create node/npm/npx wrappers early
    node() {
        if ! type nvm &> /dev/null || [[ "$(type nvm)" != *"function"* ]]; then
            _load_nvm || return 1
        fi
        unfunction node npm npx 2>/dev/null || true
        command node "$@"
    }
    
    npm() {
        if ! type nvm &> /dev/null || [[ "$(type nvm)" != *"function"* ]]; then
            _load_nvm || return 1
        fi
        unfunction node npm npx 2>/dev/null || true
        command npm "$@"
    }
    
    npx() {
        if ! type nvm &> /dev/null || [[ "$(type nvm)" != *"function"* ]]; then
            _load_nvm || return 1
        fi
        unfunction node npm npx 2>/dev/null || true
        command npx "$@"
    }
fi

# ============================================================================
# DIRENV SETUP (Before other env tools)
# ============================================================================
# Direnv must be hooked early to work with project-specific .envrc files
# Silence direnv verbose output for cleaner terminal
export DIRENV_LOG_FORMAT=""
if command -v direnv &> /dev/null; then
    eval "$(direnv hook zsh)"
fi

# ============================================================================
# CUSTOM CONFIGURATION MODULES
# ============================================================================
# Source modular configuration files from dotfiles repo
DOTFILES_ZSH="$HOME/dotfiles/zsh"

# Functions (load before aliases in case aliases use functions)
[[ -f "$DOTFILES_ZSH/functions.zsh" ]] && source "$DOTFILES_ZSH/functions.zsh"

# Aliases (loaded after Oh My Zsh so they can override plugin aliases)
[[ -f "$DOTFILES_ZSH/aliases.zsh" ]] && source "$DOTFILES_ZSH/aliases.zsh"

# Environment-specific configs (site-specific, machine-specific)
# NOTE: These configs might call nvm, so nvm wrapper must be defined above
if [[ -d "$DOTFILES_ZSH/site-specific" ]]; then
    # Source machine-specific config if it exists
    MACHINE_ID=$(system_profiler SPHardwareDataType 2>/dev/null | grep "Hardware UUID" | awk '{print $3}')
    [[ -n "$MACHINE_ID" && -f "$DOTFILES_ZSH/site-specific/.zshrc-$MACHINE_ID" ]] && \
        source "$DOTFILES_ZSH/site-specific/.zshrc-$MACHINE_ID"
fi

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================

# Node Version Manager (nvm) - Already set up above for IDE terminals
# For regular terminals, load NVM immediately
if [[ "$IS_IDE_TERMINAL" != true ]]; then
    # In regular terminals: load NVM immediately
    if [[ -s "$(brew --prefix nvm)/nvm.sh" ]]; then
        source "$(brew --prefix nvm)/nvm.sh"
    fi
fi

# Python/pipx
if command -v pipx &> /dev/null; then
    export PATH="$PATH:$(pipx list --short 2>/dev/null | head -1 | xargs dirname 2>/dev/null || echo $HOME/.local/bin)"
fi

# Conda - Lazy loaded for IDE terminals
if [[ "$IS_IDE_TERMINAL" == true ]]; then
    # In IDE terminals: lazy load Conda
    conda() {
        unfunction conda
        if command -v conda &> /dev/null; then
            eval "$(conda shell.zsh hook 2>/dev/null)"
            conda config --set auto_activate_base false 2>/dev/null || true
        fi
        command conda "$@"
    }
else
    # In regular terminals: load Conda immediately
    if command -v conda &> /dev/null; then
        eval "$(conda shell.zsh hook 2>/dev/null)"
        conda config --set auto_activate_base false 2>/dev/null || true
    fi
fi

# Bun
if [[ -d "$HOME/.bun" ]]; then
    export BUN_INSTALL="$HOME/.bun"
    export PATH="$BUN_INSTALL/bin:$PATH"
    [[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"
fi

# ============================================================================
# TERMINAL INTEGRATIONS
# ============================================================================

# IDE Terminal Optimizations (Cursor, VSCode, Antigravity)
if [[ "$IS_IDE_TERMINAL" == true ]]; then
    # Ensure proper shell detection
    export SHELL="/bin/zsh"
    
    # Disable pager in IDE terminals (faster, cleaner output)
    export GIT_PAGER='cat'
    
    # Skip heavy Oh My Zsh features in IDE terminals
    # (We already loaded Oh My Zsh, but we can optimize further)
    # Note: We still load plugins, but they're lighter in IDE context
    
    # Don't load 1Password secrets automatically in IDE terminals
    # (User can load manually if needed: op_load_item "Development" "Development API Keys")
fi

# iTerm2 shell integration
[[ -f "$HOME/.iterm2_shell_integration.zsh" ]] && source "$HOME/.iterm2_shell_integration.zsh"

# Raycast shell aliases (if exists)
[[ -f "$HOME/.raycast_shell_aliases" ]] && source "$HOME/.raycast_shell_aliases"

# ============================================================================
# COMPLETION SETUP
# ============================================================================
# Docker completions
if [[ -d "$HOME/.docker/completions" ]]; then
    fpath=("$HOME/.docker/completions" $fpath)
fi

# Initialize completion system
autoload -Uz compinit
# Only regenerate compdump if older than 24 hours (faster startup)
if [[ -n "$HOME/.zcompdump"(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi

# ============================================================================
# HISTORY CONFIGURATION
# ============================================================================
export HISTSIZE=10000
export SAVEHIST=10000
export HISTFILE="$HOME/.zsh_history"
setopt SHARE_HISTORY          # Share history between sessions
setopt HIST_IGNORE_DUPS        # Don't record duplicates
setopt HIST_IGNORE_ALL_DUPS   # Remove older duplicates
setopt HIST_FIND_NO_DUPS      # Don't show duplicates in search
setopt HIST_IGNORE_SPACE      # Ignore commands starting with space
setopt HIST_VERIFY            # Show command before executing

# ============================================================================
# MISC CONFIGURATIONS
# ============================================================================

# Locale
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# Editor
export EDITOR="${EDITOR:-code}"  # Use 'code' (VS Code/Cursor) as default
export VISUAL="$EDITOR"

# Git pager (respect IDE environment - already set above if IDE terminal)
if [[ "$IS_IDE_TERMINAL" != true ]]; then
    export GIT_PAGER='less -FRX'
fi

# ============================================================================
# POST-INITIALIZATION
# ============================================================================
# Load powerlevel10k instant prompt if available (must be last)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Load p10k config if theme is powerlevel10k
if [[ "$ZSH_THEME" == "powerlevel10k/powerlevel10k" ]] && [[ -f "$HOME/.p10k.zsh" ]]; then
    source "$HOME/.p10k.zsh"
fi

