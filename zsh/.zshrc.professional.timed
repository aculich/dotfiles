#!/usr/bin/env zsh
# Professional Zsh Configuration - WITH TIMING
# This version includes timing information to profile startup performance
# Remove timing when done profiling

# Enable profiling module
zmodload zsh/zprof

# Track startup time
typeset -F SECONDS
typeset -g _zsh_start_time=$SECONDS

# Function to log timing
_zsh_log_time() {
    local label="$1"
    local elapsed=$(($SECONDS - $_zsh_start_time))
    printf "[PROFILE] %6.3fs - %s\n" "$elapsed" "$label" >&2
}

_zsh_log_time "=== Zsh startup begins ==="

# ============================================================================
# INITIALIZATION ORDER
# ============================================================================
_zsh_log_time "Initialization setup"

# ============================================================================
# PATH SETUP (Early - before other tools)
# ============================================================================
_zsh_log_time "Setting up PATH..."

# Homebrew (must be first for Apple Silicon)
if [[ -f /opt/homebrew/bin/brew ]]; then
    eval "$(/opt/homebrew/bin/brew shellenv)"
elif [[ -f /usr/local/bin/brew ]]; then
    eval "$(/usr/local/bin/brew shellenv)"
fi

# Local bin directories (user-installed tools)
export PATH="$HOME/.local/bin:$PATH"

_zsh_log_time "PATH setup complete"

# ============================================================================
# OH-MY-ZSH SETUP
# ============================================================================
_zsh_log_time "Loading Oh My Zsh..."

export ZSH="$HOME/.oh-my-zsh"

# Set theme (can be overridden by powerlevel10k if installed)
ZSH_THEME="${ZSH_THEME:-robbyrussell}"

# Plugins - carefully curated for performance
plugins=(
    git
    direnv
    zsh-autosuggestions
    zsh-syntax-highlighting
    fzf
)

# Load Oh My Zsh
if [[ -f "$ZSH/oh-my-zsh.sh" ]]; then
    source "$ZSH/oh-my-zsh.sh"
    _zsh_log_time "Oh My Zsh loaded"
fi

# ============================================================================
# DIRENV SETUP (Before other env tools)
# ============================================================================
_zsh_log_time "Setting up direnv..."

# Direnv must be hooked early to work with project-specific .envrc files
# Silence direnv verbose output for cleaner terminal
export DIRENV_LOG_FORMAT=""
if command -v direnv &> /dev/null; then
    eval "$(direnv hook zsh)"
    _zsh_log_time "Direnv hook installed"
fi

# ============================================================================
# CUSTOM CONFIGURATION MODULES
# ============================================================================
_zsh_log_time "Loading custom modules..."

# Source modular configuration files from dotfiles repo
DOTFILES_ZSH="$HOME/dotfiles/zsh"

# Functions (load before aliases in case aliases use functions)
[[ -f "$DOTFILES_ZSH/functions.zsh" ]] && source "$DOTFILES_ZSH/functions.zsh" && _zsh_log_time "Functions loaded"

# Aliases (loaded after Oh My Zsh so they can override plugin aliases)
[[ -f "$DOTFILES_ZSH/aliases.zsh" ]] && source "$DOTFILES_ZSH/aliases.zsh" && _zsh_log_time "Aliases loaded"

# Environment-specific configs (site-specific, machine-specific)
if [[ -d "$DOTFILES_ZSH/site-specific" ]]; then
    # Source machine-specific config if it exists
    MACHINE_ID=$(system_profiler SPHardwareDataType 2>/dev/null | grep "Hardware UUID" | awk '{print $3}')
    [[ -n "$MACHINE_ID" && -f "$DOTFILES_ZSH/site-specific/.zshrc-$MACHINE_ID" ]] && \
        source "$DOTFILES_ZSH/site-specific/.zshrc-$MACHINE_ID" && _zsh_log_time "Site-specific config loaded"
fi

# ============================================================================
# DEVELOPMENT TOOLS
# ============================================================================
_zsh_log_time "Loading development tools..."

# Node Version Manager (nvm)
export NVM_DIR="$HOME/.nvm"
if [[ -s "$(brew --prefix nvm)/nvm.sh" ]]; then
    source "$(brew --prefix nvm)/nvm.sh"
    _zsh_log_time "NVM loaded"
fi

# Python/pipx
if command -v pipx &> /dev/null; then
    export PATH="$PATH:$(pipx list --short 2>/dev/null | head -1 | xargs dirname 2>/dev/null || echo $HOME/.local/bin)"
fi

# Conda (if installed)
if command -v conda &> /dev/null; then
    eval "$(conda shell.zsh hook 2>/dev/null)"
    conda config --set auto_activate_base false 2>/dev/null || true
    _zsh_log_time "Conda loaded"
fi

# Bun
if [[ -d "$HOME/.bun" ]]; then
    export BUN_INSTALL="$HOME/.bun"
    export PATH="$BUN_INSTALL/bin:$PATH"
    [[ -s "$BUN_INSTALL/_bun" ]] && source "$BUN_INSTALL/_bun"
    _zsh_log_time "Bun loaded"
fi

# ============================================================================
# TERMINAL INTEGRATIONS
# ============================================================================
_zsh_log_time "Loading terminal integrations..."

# Cursor IDE shell integration
if [[ "$TERM_PROGRAM" == "cursor" ]] || [[ -n "$CURSOR_SHELL_INTEGRATION" ]]; then
    # Ensure proper shell detection for Cursor
    export SHELL="/bin/zsh"
    # Cursor-specific optimizations
    export GIT_PAGER='cat'  # Disable pager in Cursor terminals
fi

# iTerm2 shell integration
[[ -f "$HOME/.iterm2_shell_integration.zsh" ]] && source "$HOME/.iterm2_shell_integration.zsh" && _zsh_log_time "iTerm2 integration loaded"

# Raycast shell aliases (if exists)
[[ -f "$HOME/.raycast_shell_aliases" ]] && source "$HOME/.raycast_shell_aliases"

# ============================================================================
# COMPLETION SETUP
# ============================================================================
_zsh_log_time "Initializing completion system..."

# Docker completions
if [[ -d "$HOME/.docker/completions" ]]; then
    fpath=("$HOME/.docker/completions" $fpath)
fi

# Initialize completion system
autoload -Uz compinit
# Only regenerate compdump if older than 24 hours (faster startup)
if [[ -n "$HOME/.zcompdump"(#qN.mh+24) ]]; then
    compinit
else
    compinit -C
fi

_zsh_log_time "Completion system initialized"

# ============================================================================
# HISTORY CONFIGURATION
# ============================================================================
export HISTSIZE=10000
export SAVEHIST=10000
export HISTFILE="$HOME/.zsh_history"
setopt SHARE_HISTORY          # Share history between sessions
setopt HIST_IGNORE_DUPS        # Don't record duplicates
setopt HIST_IGNORE_ALL_DUPS   # Remove older duplicates
setopt HIST_FIND_NO_DUPS      # Don't show duplicates in search
setopt HIST_IGNORE_SPACE      # Ignore commands starting with space
setopt HIST_VERIFY            # Show command before executing

# ============================================================================
# MISC CONFIGURATIONS
# ============================================================================

# Locale
export LC_ALL=en_US.UTF-8
export LANG=en_US.UTF-8

# Editor
export EDITOR="${EDITOR:-code}"  # Use 'code' (VS Code/Cursor) as default
export VISUAL="$EDITOR"

# Git pager (respect Cursor environment)
if [[ "$TERM_PROGRAM" =~ ^(vscode|cursor)$ ]]; then
    export GIT_PAGER='cat'
else
    export GIT_PAGER='less -FRX'
fi

# ============================================================================
# POST-INITIALIZATION
# ============================================================================
# Load powerlevel10k instant prompt if available (must be last)
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
    source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
    _zsh_log_time "Powerlevel10k instant prompt loaded"
fi

# Load p10k config if theme is powerlevel10k
if [[ "$ZSH_THEME" == "powerlevel10k/powerlevel10k" ]] && [[ -f "$HOME/.p10k.zsh" ]]; then
    source "$HOME/.p10k.zsh"
    _zsh_log_time "Powerlevel10k config loaded"
fi

_zsh_log_time "=== Zsh startup complete ==="

# Show detailed profile if ZPROF environment variable is set
if [[ -n "$ZPROF" ]]; then
    echo ""
    echo "=== Detailed Profile (zprof) ===" >&2
    zprof >&2
fi

