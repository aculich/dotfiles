export NVM_DIR="$HOME/.nvm"
[ -s "/opt/homebrew/opt/nvm/nvm.sh" ] && . "/opt/homebrew/opt/nvm/nvm.sh"  # This loads nvmk
[ -s "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm" ] && . "/opt/homebrew/opt/nvm/etc/bash_completion.d/nvm"  # This loads nvm bash_completion

## Run on shell startup
# autoload-nvmrc-improved
# bun completions
[ -s "/Users/me/.bun/_bun" ] && source "/Users/me/.bun/_bun"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
eval "$(fnm env --use-on-cd --shell zsh)"
export OP_ACCOUNT=my.1password.com

# Parallel (web search / research) - API keys: https://platform.parallel.ai/settings?tab=api-keys
export PARALLEL_API_KEY="<REDACTED>"

# OpenClaw Completion
source "/Users/me/.openclaw/completions/openclaw.zsh"

# Added by Antigravity
export PATH="/Users/me/.antigravity/antigravity/bin:$PATH"
