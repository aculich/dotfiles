@charset "utf-8";

.sk_theme { background: rgb(255, 255, 255); color: rgb(0, 0, 0); }

.sk_theme input { color: rgb(0, 0, 0); }

.sk_theme .url { color: rgb(34, 34, 34); }

.sk_theme .annotation { color: rgb(34, 34, 34); }

.sk_theme kbd { background: rgb(221, 221, 221); color: rgb(17, 17, 17); }

.sk_theme .frame { background: rgba(129, 120, 222, 0.62); }

.sk_theme .omnibar_highlight { color: rgb(185, 12, 12); }

.sk_theme .omnibar_folder { color: rgb(75, 58, 204); }

.sk_theme .omnibar_timestamp { color: rgb(204, 75, 156); }

.sk_theme .omnibar_visitcount { color: rgb(30, 70, 233); }

.sk_theme .prompt, .sk_theme .resultPage { color: rgb(170, 170, 170); }

.sk_theme .feature_name { color: rgb(224, 155, 126); }

.sk_theme .separator { color: rgb(181, 181, 7); }

body { margin: 0px; font-family: "Helvetica Neue", Helvetica, Arial, sans-s=
erif; font-size: 12px; }

#sk_omnibar { overflow: hidden; position: fixed; width: 80%; max-height: 10=
0vh; left: 10%; text-align: left; box-shadow: rgba(0, 0, 0, 0.8) 0px 2px 10=
px; z-index: 2147483000; }

.sk_omnibar_middle { top: 10%; border-radius: 4px; }

.sk_omnibar_bottom { bottom: 0px; border-radius: 4px 4px 0px 0px; }

#sk_omnibar span.omnibar_highlight { text-shadow: 0px 0px 0.01em; }

#sk_omnibarSearchArea .prompt, #sk_omnibarSearchArea .resultPage { display:=
 inline-block; font-size: 20px; width: auto; }

#sk_omnibarSearchArea > input { display: inline-block; width: 100%; flex: 1=
 1 0%; font-size: 20px; margin-bottom: 0px; padding: 0px 0px 0px 0.5rem; ba=
ckground: transparent; border-style: none; outline: none; }

#sk_omnibarSearchArea { display: flex; align-items: center; border-bottom: =
1px solid rgb(153, 153, 153); }

.sk_omnibar_middle #sk_omnibarSearchArea { margin: 0.5rem 1rem; }

.sk_omnibar_bottom #sk_omnibarSearchArea { margin: 0.2rem 1rem; }

.sk_omnibar_middle #sk_omnibarSearchResult > ul { margin-top: 0px; }

.sk_omnibar_bottom #sk_omnibarSearchResult > ul { margin-bottom: 0px; }

#sk_omnibarSearchResult { max-height: 60vh; overflow: hidden; margin: 0rem =
0.6rem; }

#sk_omnibarSearchResult.llmChat { overflow: auto; max-height: 90vh; scrollb=
ar-width: thin; }

#sk_omnibarSearchResult:empty { display: none; }

#sk_omnibarSearchResult.llmChat > h4 { background-color: rgb(27, 84, 29); b=
order-radius: 4px; padding: 4px; position: absolute; right: 30px; }

#sk_omnibarSearchResult > ul { padding: 0px; }

#sk_omnibarSearchResult > ul > li { padding: 0.2rem 0rem; display: flex; al=
ign-items: center; max-height: 600px; overflow: hidden auto; }

#sk_omnibarSearchResult.llmChat > ul > li { max-height: max-content; }

#sk_omnibarSearchResult.llmChat > ul > li::before { font-size: 20px; paddin=
g: 5px; }

#sk_omnibarSearchResult.llmChat > ul > li.role-user::before { content: var(=
