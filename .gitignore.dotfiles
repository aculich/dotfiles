# .gitignore for dotfiles repository
# Add this to your dotfiles repo's .gitignore

# Secrets and sensitive files
.envrc
*.envrc
*.secret
*.key
*.pem
*.p12
*.pfx

# Backups
*.backup.*
*.old
*.bak
*~

# OS files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/
*.sublime-*

# Temporary files
*.tmp
*.log
*.cache

# Machine-specific configs (optional - you may want to track these)
# site-specific/.zshrc-*

